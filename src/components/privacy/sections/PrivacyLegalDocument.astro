---
import type { SupportedLocale } from "../../../data/localization-contract.ts";
import LegalDocumentLayout from "../../shared/LegalDocumentLayout.astro";
import "../../../styles/privacy/sections/privacy-legal-document.css";

type PrivacySection = {
  id: string;
  title: string;
  body: string;
  titleEditAttributes?: Record<string, string>;
  bodyEditAttributes?: Record<string, string>;
};

type Props = {
  id: string;
  eyebrow: string;
  title: string;
  updatedLabel: string;
  sections: PrivacySection[];
  contactText: string;
  locale: SupportedLocale;
  eyebrowEditAttributes?: Record<string, string>;
  titleEditAttributes?: Record<string, string>;
  updatedEditAttributes?: Record<string, string>;
  contactEditAttributes?: Record<string, string>;
};

const {
  id,
  eyebrow,
  title,
  updatedLabel,
  sections,
  contactText,
  locale,
  eyebrowEditAttributes = {},
  titleEditAttributes = {},
  updatedEditAttributes = {},
  contactEditAttributes = {},
} = Astro.props as Props;
---

<LegalDocumentLayout
  id={id}
  eyebrow={eyebrow}
  title={title}
  updatedLabel={updatedLabel}
  sections={sections.map((section) => ({
    id: section.id,
    title: section.title,
    paragraphs: [section.body],
    headingEditAttributes: section.titleEditAttributes,
    paragraphEditAttributes: [section.bodyEditAttributes ?? {}],
  }))}
  contactPrefix={contactText}
  locale={locale}
  eyebrowEditAttributes={eyebrowEditAttributes}
  titleEditAttributes={titleEditAttributes}
  updatedEditAttributes={updatedEditAttributes}
  contactEditAttributes={contactEditAttributes}
  class="privacy-legal-document"
  data-privacy-legal-document
/>
