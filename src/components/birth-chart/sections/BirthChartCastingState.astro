---
import type { BirthChartCastingStateCopy } from "../../../data/locale/birth-chart/sections/casting-state.ts";
import CastingState from "../../shared/CastingState.astro";
import "../../../styles/birth-chart/sections/casting-state.css";

type Props = {
  copy: BirthChartCastingStateCopy;
  editAttributes?: (
    field: keyof BirthChartCastingStateCopy,
  ) => Record<string, string>;
};

const { copy, editAttributes = () => ({}) } = Astro.props as Props;
---

<CastingState
  class="birth-chart-casting"
  data-birth-chart-casting
  title={copy.casting_title}
  statusLabel={copy.casting_status}
  summary={copy.casting_summary}
  visual="single"
  height="viewport"
  headingTag="h1"
  titleEditAttributes={editAttributes("casting_title")}
  statusEditAttributes={editAttributes("casting_status")}
  summaryEditAttributes={editAttributes("casting_summary")}
  tabindex="-1"
  hidden
/>
