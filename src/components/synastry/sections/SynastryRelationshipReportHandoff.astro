---
import type { SupportedLocale } from "../../../data/localization-contract.ts";
import type { SynastryRelationshipReportHandoffCopy } from "../../../data/locale/synastry/sections/relationship-report-handoff.ts";
import FinalCtaSection from "../../shared/FinalCtaSection.astro";
import "../../../styles/synastry/sections/relationship-report-handoff.css";

type Props = {
  copy: SynastryRelationshipReportHandoffCopy;
  locale: SupportedLocale;
  editAttributes?: (
    field: keyof SynastryRelationshipReportHandoffCopy,
  ) => Record<string, string>;
};

const { copy, locale, editAttributes = () => ({}) } = Astro.props as Props;
---

<FinalCtaSection
  id="synastry-relationship-report"
  class="synastry-relationship-report"
  eyebrow={copy.report_eyebrow}
  title={copy.report_title}
  description={copy.report_description}
  primaryLabel={copy.report_primary_label}
  primaryHref="/reports"
  secondaryLabel={copy.report_secondary_label}
  secondaryHref="/synastry"
  locale={locale}
  tone="light"
  layout="split"
  surface="panel"
  density="compact"
  eyebrowEditAttributes={editAttributes("report_eyebrow")}
  titleEditAttributes={editAttributes("report_title")}
  descriptionEditAttributes={editAttributes("report_description")}
  primaryEditAttributes={editAttributes("report_primary_label")}
  secondaryEditAttributes={editAttributes("report_secondary_label")}
/>
