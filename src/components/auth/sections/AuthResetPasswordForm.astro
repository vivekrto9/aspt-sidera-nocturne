---
import { localizePath } from "../../../data/localization-contract.ts";
import type { SupportedLocale } from "../../../data/localization-contract.ts";
import type { AuthResetPasswordFormCopy } from "../../../data/locale/auth/sections/reset-password-form.ts";
import Button from "../../shared/Button.astro";
import PasswordField from "../../shared/PasswordField.astro";
import "../../../styles/auth/sections/reset-password-form.css";

type Props = {
  copy: AuthResetPasswordFormCopy;
  locale: SupportedLocale;
  editAttributes?: (field: string) => Record<string, string>;
};

const { copy, locale, editAttributes } = Astro.props as Props;
const edit = (field: string) => editAttributes?.(field) ?? {};
const loginHref = localizePath("/login", locale);

const runtimeCopy = JSON.stringify({
  loadingLabel: copy.loadingLabel,
  successLabel: copy.successLabel,
  mismatchLabel: copy.mismatchLabel,
  invalidPasswordLabel: copy.invalidPasswordLabel,
}).replace(/</g, "\\u003c");
---

<form
  class="sidera-auth-reset-password"
  data-auth-reset-password-form
  data-runtime-copy={runtimeCopy}
  data-locale={locale}
  data-login-href={loginHref}
  novalidate
>
  <div class="sidera-auth-reset-password__intro">
    <h2 {...edit("reset_password_form_heading")}>{copy.heading}</h2>
    <p {...edit("reset_password_form_subheading")}>{copy.subheading}</p>
  </div>

  <div class="sidera-auth-reset-password__field">
    <PasswordField
      id="reset-password-password"
      name="password"
      label={copy.passwordLabel}
      showLabel={copy.passwordLabel}
      hideLabel={copy.passwordLabel}
      autocomplete="new-password"
      placeholder={copy.passwordPlaceholder}
      required
      minlength={8}
      ariaDescribedby="reset-password-password-help reset-password-password-runtime-error"
      inputClass="sidera-auth-reset-password__field-input"
      inputAttributes={{
        "data-auth-reset-password-input": "password",
        ...edit("reset_password_password_placeholder"),
      }}
      class="sidera-auth-reset-password__password-field"
      labelEditAttributes={edit("reset_password_password_label")}
      helpText={copy.passwordHint}
      helpEditAttributes={edit("reset_password_password_hint")}
    />
    <p class="sidera-auth-reset-password__field-error" id="reset-password-password-runtime-error" data-auth-reset-password-error="password" role="alert" hidden></p>
  </div>

  <div class="sidera-auth-reset-password__field">
    <PasswordField
      id="reset-password-confirm"
      name="confirmPassword"
      label={copy.confirmPasswordLabel}
      showLabel={copy.confirmPasswordLabel}
      hideLabel={copy.confirmPasswordLabel}
      autocomplete="new-password"
      placeholder={copy.confirmPasswordPlaceholder}
      required
      minlength={8}
      ariaDescribedby="reset-password-confirm-runtime-error"
      inputClass="sidera-auth-reset-password__field-input"
      inputAttributes={{
        "data-auth-reset-password-input": "confirmPassword",
        ...edit("reset_password_confirm_placeholder"),
      }}
      class="sidera-auth-reset-password__password-field"
      labelEditAttributes={edit("reset_password_confirm_label")}
    />
    <p class="sidera-auth-reset-password__field-error" id="reset-password-confirm-runtime-error" data-auth-reset-password-error="confirmPassword" role="alert" hidden></p>
  </div>

  <div class="sidera-auth-reset-password__actions">
    <p
      class="sidera-auth-reset-password__status"
      data-auth-reset-password-status
      aria-live="polite"
      aria-atomic="true"
    ></p>

    <Button
      class="sidera-auth-reset-password__submit"
      type="submit"
      shape="rounded"
      size="large"
      fullWidth
      loading={false}
      loadingLabel={copy.loadingLabel}
      data-auth-reset-password-submit
      editAttributes={edit("reset_password_submit_label")}
    >
      {copy.submitLabel}
    </Button>

    <p class="sidera-auth-reset-password__switch">
      <span {...edit("reset_password_login_prompt")}>{copy.loginPrompt}</span>
      {" "}
      <a href={loginHref} {...edit("reset_password_login_label")}>
        {copy.loginLabel}
      </a>
    </p>
  </div>
</form>

<script>
  import { setActionLoading } from "../../../scripts/action-loading.ts";

  const initializeAuthResetPasswordForms = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-auth-reset-password-form]")
      .forEach((form) => {
        if (form.dataset.authResetPasswordReady === "true") return;

        const runtimeCopy = JSON.parse(form.dataset.runtimeCopy || "{}");
        const status = form.querySelector<HTMLElement>(
          "[data-auth-reset-password-status]",
        );
        const submit = form.querySelector<HTMLButtonElement>(
          "[data-auth-reset-password-submit]",
        );
        const inputs = {
          password: form.querySelector<HTMLInputElement>(
            '[data-auth-reset-password-input="password"]',
          ),
          confirmPassword: form.querySelector<HTMLInputElement>(
            '[data-auth-reset-password-input="confirmPassword"]',
          ),
        };

        const errors = Object.fromEntries(
          Array.from(form.querySelectorAll<HTMLElement>("[data-auth-reset-password-error]")).map(
            (error) => [error.dataset.authResetPasswordError, error],
          ),
        ) as Record<string, HTMLElement>;

        const fieldRoot = (input: HTMLInputElement | null) =>
          input?.closest<HTMLElement>(".sidera-form-field") ?? null;

        const clearError = (key: keyof typeof inputs) => {
          const input = inputs[key];
          const root = fieldRoot(input);
          const error = errors[key];
          if (!input || !root || !error) return;
          input.removeAttribute("aria-invalid");
          root.classList.remove("sidera-form-field--invalid");
          error.textContent = "";
          error.hidden = true;
          root.removeAttribute("data-invalid");
        };

        const showError = (key: keyof typeof inputs, message: string) => {
          const input = inputs[key];
          const root = fieldRoot(input);
          const error = errors[key];
          if (!input || !root || !error) return;
          input.setAttribute("aria-invalid", "true");
          root.classList.add("sidera-form-field--invalid");
          root.setAttribute("data-invalid", "true");
          error.textContent = message;
          error.hidden = false;
        };

        const setStatus = (message = "", isError = false) => {
          if (!status) return;
          status.textContent = message;
          status.classList.toggle(
            "sidera-auth-reset-password__status--error",
            isError,
          );
          status.classList.toggle(
            "sidera-auth-reset-password__status--success",
            !isError && Boolean(message),
          );
        };

        Object.values(inputs).forEach((input) => {
          input?.addEventListener("input", () => {
            const key = input?.name;
            if (!key) return;
            if (key === "password") {
              clearError("password");
            } else if (key === "confirmPassword") {
              clearError("confirmPassword");
            }
            setStatus("", false);
          });
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (form.getAttribute("aria-busy") === "true") return;
          Object.keys(inputs).forEach((key) => clearError(key as keyof typeof inputs));
          setStatus();

          const invalidFields: Array<keyof typeof inputs> = [];
          if (!inputs.password?.value.trim() || !inputs.password.checkValidity()) {
            showError(
              "password",
              runtimeCopy.invalidPasswordLabel || "Enter a valid password.",
            );
            invalidFields.push("password");
          }

          if (!inputs.confirmPassword?.value.trim()) {
            showError(
              "confirmPassword",
              runtimeCopy.invalidPasswordLabel || "Enter a valid password.",
            );
            invalidFields.push("confirmPassword");
          } else if (inputs.password?.value !== inputs.confirmPassword?.value) {
            showError("confirmPassword", runtimeCopy.mismatchLabel);
            invalidFields.push("confirmPassword");
          }

          if (invalidFields.length) {
            inputs[invalidFields[0]]?.focus();
            return;
          }

          setActionLoading(submit, true, runtimeCopy.loadingLabel);
          form.setAttribute("aria-busy", "true");
          let navigationStarted = false;

          try {
            const response = await fetch("/api/astropages/generated-site/customer-auth/reset-password", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                token: new URLSearchParams(window.location.search).get("token") || "",
                password: inputs.password?.value,
                locale: form.dataset.locale,
              }),
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
              setStatus(payload.message || runtimeCopy.invalidPasswordLabel, true);
              return;
            }
            setStatus(runtimeCopy.successLabel);
            navigationStarted = true;
            window.setTimeout(() => window.location.assign(form.dataset.loginHref || "/login"), 700);
          } catch {
            setStatus(runtimeCopy.invalidPasswordLabel, true);
          } finally {
            if (!navigationStarted) {
              setActionLoading(submit, false);
              form.setAttribute("aria-busy", "false");
            }
          }
        });

        form.dataset.authResetPasswordReady = "true";
      });
  };

  initializeAuthResetPasswordForms();
  document.addEventListener("astro:page-load", initializeAuthResetPasswordForms);
</script>
