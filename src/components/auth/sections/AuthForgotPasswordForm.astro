---
import { localizePath, type SupportedLocale } from "../../../data/localization-contract.ts";
import type { AuthForgotPasswordFormCopy } from "../../../data/locale/auth/sections/forgot-password-form.ts";
import Button from "../../shared/Button.astro";
import FormField from "../../shared/FormField.astro";
import TextField from "../../shared/TextField.astro";
import "../../../styles/auth/sections/forgot-password-form.css";

type Props = {
  copy: AuthForgotPasswordFormCopy;
  locale: SupportedLocale;
  editAttributes?: (field: string) => Record<string, string>;
};

const { copy, locale, editAttributes } = Astro.props as Props;
const edit = (field: string) => editAttributes?.(field) ?? {};
const runtimeCopy = JSON.stringify({
  loadingLabel: copy.loadingLabel,
  successLabel: copy.successLabel,
  resentSuccessLabel: copy.resentSuccessLabel,
  invalidEmailLabel: copy.invalidEmailLabel,
  resendCountdownLabel: copy.resendCountdownLabel,
  resendReadyLabel: copy.resendReadyLabel,
}).replace(/</g, "\\u003c");
const loginHref = localizePath("/login", locale);
---

<form
  class="sidera-auth-forgot-password"
  data-auth-forgot-password-form
  data-runtime-copy={runtimeCopy}
  data-locale={locale}
  novalidate
>
  <div class="sidera-auth-forgot-password__intro">
    <h2 {...edit("forgot_password_form_heading")}>{copy.heading}</h2>
    <p {...edit("forgot_password_form_subheading")}>{copy.subheading}</p>
  </div>

  <FormField
    class="sidera-auth-forgot-password__field"
    data-auth-forgot-password-field
    controlId="forgot-password-email"
    label={copy.emailLabel}
    required
    labelEditAttributes={edit("forgot_password_email_label")}
  >
    <TextField
      id="forgot-password-email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder={copy.emailPlaceholder}
      required
      inputmode="email"
      data-auth-forgot-password-input="email"
      {...edit("forgot_password_email_placeholder")}
    />
  </FormField>

  <p
    class="sidera-auth-forgot-password__error"
    data-auth-forgot-password-error
    role="alert"
    aria-live="polite"
    hidden
  ></p>

  <p
    class="sidera-auth-forgot-password__status"
    data-auth-forgot-password-status
    aria-live="polite"
    aria-atomic="true"
  ></p>

  <Button
    class="sidera-auth-forgot-password__submit"
    type="submit"
    shape="rounded"
    size="large"
    fullWidth
    loading={false}
    loadingLabel={copy.loadingLabel}
    data-auth-forgot-password-submit
    editAttributes={edit("forgot_password_submit_label")}
  >
    {copy.submitLabel}
  </Button>

  <div class="sidera-auth-forgot-password__resend" data-auth-forgot-password-resend hidden>
    <p class="sidera-auth-forgot-password__resend-row">
      <span {...edit("forgot_password_resend_prompt")}>{copy.resendPrompt}</span>
      <Button
        class="sidera-auth-forgot-password__resend-action"
        type="button"
        variant="link"
        size="compact"
        disabled
        loading={false}
        loadingLabel={copy.loadingLabel}
        editAttributes={edit("forgot_password_resend_label")}
      >
        {copy.resendLabel}
      </Button>
    </p>
    <p
      class="sidera-auth-forgot-password__resend-timer"
      data-auth-forgot-password-resend-timer
      role="timer"
      aria-live="off"
      aria-atomic="true"
    ></p>
  </div>

  <p class="sidera-auth-forgot-password__switch">
    <span {...edit("forgot_password_login_prompt")}>{copy.loginPrompt}</span>
    <a href={loginHref} {...edit("forgot_password_login_label")}>{copy.loginLabel}</a>
  </p>
</form>

<script>
  import { setActionLoading } from "../../../scripts/action-loading.ts";

  const initializeAuthForgotPasswordForms = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-auth-forgot-password-form]")
      .forEach((form) => {
        if (form.dataset.authForgotPasswordReady === "true") return;

        const runtimeCopy = JSON.parse(form.dataset.runtimeCopy || "{}");
        const status = form.querySelector<HTMLElement>("[data-auth-forgot-password-status]");
        const error = form.querySelector<HTMLElement>("[data-auth-forgot-password-error]");
        const submit = form.querySelector<HTMLButtonElement>(
          ".sidera-auth-forgot-password__submit",
        );
        const resend = form.querySelector<HTMLElement>(
          "[data-auth-forgot-password-resend]",
        );
        const resendButton = form.querySelector<HTMLButtonElement>(
          ".sidera-auth-forgot-password__resend-action",
        );
        const resendTimer = form.querySelector<HTMLElement>(
          "[data-auth-forgot-password-resend-timer]",
        );
        const email = form.querySelector<HTMLInputElement>(
          '[data-auth-forgot-password-input="email"]',
        );
        const fieldRoot = form.querySelector<HTMLElement>(
          "[data-auth-forgot-password-field]",
        );
        const fieldError = fieldRoot?.querySelector<HTMLElement>(
          ".sidera-form-field__error",
        );
        let cooldownInterval: number | undefined;
        let cooldownEndsAt = 0;

        const stopCooldown = () => {
          if (cooldownInterval !== undefined) window.clearInterval(cooldownInterval);
          cooldownInterval = undefined;
          cooldownEndsAt = 0;
        };

        const formatTime = (seconds: number) =>
          `00:${String(seconds).padStart(2, "0")}`;

        const updateCooldown = () => {
          if (!resendButton || !resendTimer) return;
          const seconds = Math.max(0, Math.ceil((cooldownEndsAt - Date.now()) / 1000));

          if (seconds === 0) {
            stopCooldown();
            resendButton.disabled = false;
            resendTimer.setAttribute("aria-live", "polite");
            resendTimer.textContent = runtimeCopy.resendReadyLabel || "You can resend now.";
            return;
          }

          resendButton.disabled = true;
          resendTimer.setAttribute("aria-live", "off");
          const countdownLabel = runtimeCopy.resendCountdownLabel || "Available in {time}";
          resendTimer.textContent = countdownLabel.replace("{time}", formatTime(seconds));
        };

        const startCooldown = () => {
          stopCooldown();
          if (resend) resend.hidden = false;
          if (submit) submit.disabled = true;
          cooldownEndsAt = Date.now() + 60_000;
          updateCooldown();
          cooldownInterval = window.setInterval(updateCooldown, 1_000);
        };

        const resetDeliveryState = () => {
          stopCooldown();
          if (resend) resend.hidden = true;
          if (resendButton) resendButton.disabled = true;
          if (resendTimer) resendTimer.textContent = "";
          if (submit) submit.disabled = false;
        };

        const setStatus = (message = "", variant: "neutral" | "error" | "success" = "neutral") => {
          if (!status) return;
          status.textContent = message;
          status.classList.toggle("sidera-auth-forgot-password__status--error", variant === "error");
          status.classList.toggle(
            "sidera-auth-forgot-password__status--success",
            variant === "success",
          );
        };

        const clearError = () => {
          if (!fieldRoot || !fieldError) return;
          email?.setAttribute("aria-invalid", "false");
          fieldRoot.classList.remove("sidera-form-field--invalid");
          fieldError.textContent = "";
          if (error) {
            error.textContent = "";
            error.hidden = true;
          }
        };

        const showError = (message: string) => {
          setStatus("", "neutral");
          if (fieldRoot && fieldError) {
            email?.setAttribute("aria-invalid", "true");
            fieldRoot.classList.add("sidera-form-field--invalid");
            fieldError.textContent = message;
          } else if (error) {
            error.textContent = message;
            error.hidden = false;
          }
        };

        email?.addEventListener("input", () => {
          clearError();
          setStatus("", "neutral");
          resetDeliveryState();
        });

        const sendResetLink = async (isResend = false) => {
          const activeButton = isResend ? resendButton : submit;
          setStatus("", "neutral");
          setActionLoading(activeButton, true, runtimeCopy.loadingLabel);
          if (isResend && submit) submit.disabled = true;
          if (!isResend && resendButton) resendButton.disabled = true;
          form.setAttribute("aria-busy", "true");
          let delivered = false;

          try {
            const response = await fetch("/api/astropages/generated-site/customer-auth/request-password-reset", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ email: email?.value.trim(), locale: form.dataset.locale }),
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
              showError(payload.message || runtimeCopy.invalidEmailLabel);
              return;
            }
            delivered = true;
            setStatus(
              isResend ? runtimeCopy.resentSuccessLabel : runtimeCopy.successLabel,
              "success",
            );
          } catch {
            showError(runtimeCopy.invalidEmailLabel || "Reset instructions could not be sent.");
          } finally {
            setActionLoading(activeButton, false);
            form.setAttribute("aria-busy", "false");
            if (delivered) startCooldown();
            else resetDeliveryState();
          }
        };

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (
            form.getAttribute("aria-busy") === "true" ||
            (resend && !resend.hidden)
          ) return;
          clearError();

          if (!email?.checkValidity()) {
            showError(runtimeCopy.invalidEmailLabel || "Enter a valid email address.");
            email?.focus();
            return;
          }

          await sendResetLink(false);
        });

        resendButton?.addEventListener("click", async () => {
          if (resendButton.disabled || form.getAttribute("aria-busy") === "true") return;
          await sendResetLink(true);
        });

        form.dataset.authForgotPasswordReady = "true";
      });
  };

  initializeAuthForgotPasswordForms();
  document.addEventListener("astro:page-load", initializeAuthForgotPasswordForms);
</script>
