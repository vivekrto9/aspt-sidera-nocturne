---
import Button from "../../shared/Button.astro";

type Props = { copy: Record<string, string>; wallet: { balance: string; balanceCents: number; currency: string }; transactions: Array<Record<string, unknown>>; offers: ReadonlyArray<{ id: string; amountCents: number; creditCents: number; bonusCents: number }>; minimumCents: number; maximumCents: number; recentLimit: number; csrfToken: string; locale: string; browseHref: string; transactionsHref: string; paymentState: string; paymentProvider: string; rechargeId: string; attemptId: string; sessionId: string; paymentRecharge?: { amountCents: number; creditCents: number; bonusCents: number; currency: string; paymentState: string } | null };
const { copy: sourceCopy, wallet, transactions, offers, minimumCents, maximumCents, recentLimit, csrfToken, locale, browseHref, transactionsHref, paymentState, paymentProvider, rechargeId, attemptId, sessionId, paymentRecharge } = Astro.props as Props;
const copy = Object.fromEntries(Object.entries(sourceCopy).map(([key, value]) => [key, value.replaceAll("Stripe Checkout", "secure checkout").replaceAll("Stripe", "the payment provider")])) as Record<string, string>;
const state = paymentState === "success" ? "verifying" : paymentState === "pending" ? "pending" : paymentState === "cancelled" ? "cancelled" : paymentState === "failed" ? "failed" : "idle";
const formatDate = (value: unknown) => value ? new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" }).format(new Date(String(value))) : "";
const money = new Intl.NumberFormat(locale, { style: "currency", currency: wallet.currency, minimumFractionDigits: 0, maximumFractionDigits: 2 });
const firstOffer = offers[0];
const symbol = money.formatToParts(0).find((part) => part.type === "currency")?.value || wallet.currency;
const receiptMoney = paymentRecharge
  ? new Intl.NumberFormat(locale, { style: "currency", currency: paymentRecharge.currency, minimumFractionDigits: 0, maximumFractionDigits: 2 })
  : money;
---
<main class="wallet-page" data-wallet-app data-csrf={csrfToken} data-locale={locale} data-currency={wallet.currency} data-wallet-balance-cents={wallet.balanceCents} data-minimum-cents={minimumCents} data-maximum-cents={maximumCents} data-recent-limit={recentLimit} data-state={state} data-payment-provider={paymentProvider} data-recharge-id={rechargeId} data-attempt-id={attemptId} data-session-id={sessionId}>
  <section class="wallet-hero" aria-labelledby="wallet-title">
    <div class="wallet-hero__copy">
      <p>{copy.eyebrow}</p>
      <h1 id="wallet-title">{copy.title}</h1>
      <span>{copy.body}</span>
      <div class="wallet-hero__actions">
        <Button href={browseHref} variant="primary" size="large" shape="rounded">{copy.browse}</Button>
        <Button href={transactionsHref} variant="secondary" size="large" shape="rounded">{copy.transactions}</Button>
      </div>
    </div>
    <div class="wallet-balance-card"><span>{copy.available}</span><strong data-wallet-balance-main>{wallet.balance}</strong></div>
  </section>

  <section class:list={["wallet-notice", state !== "idle" && "is-visible"]} data-wallet-notice aria-live="polite">
    <span class="wallet-notice__icon" aria-hidden="true">{state === "cancelled" || state === "failed" ? "!" : "✓"}</span>
    <div><strong data-wallet-notice-title>{state === "cancelled" ? copy.cancelled_title : state === "failed" ? copy.failed_title : copy.success_title}</strong><p data-wallet-notice-body>{state === "cancelled" ? copy.cancelled_body : state === "failed" ? copy.failed_body : copy.verifying}</p></div>
    {state === "failed" || state === "cancelled" ? <a href="#wallet-recharge" data-wallet-notice-action>{copy.retry}</a> : <a href="#wallet-recharge" data-wallet-notice-action hidden>{copy.retry}</a>}
    {paymentRecharge ? (
      <dl data-wallet-payment-receipt data-payment-state={paymentRecharge.paymentState}>
        <div><dt>{copy.recharge_amount}</dt><dd>{receiptMoney.format(paymentRecharge.amountCents / 100)} {paymentRecharge.currency}</dd></div>
        <div><dt>{copy.after_recharge}</dt><dd>{receiptMoney.format(paymentRecharge.creditCents / 100)} {paymentRecharge.currency}</dd></div>
        {paymentRecharge.bonusCents ? <div><dt>{copy.bonus}</dt><dd>{receiptMoney.format(paymentRecharge.bonusCents / 100)} {paymentRecharge.currency}</dd></div> : null}
      </dl>
    ) : null}
  </section>

  <section class="wallet-grid">
    <form class="wallet-recharge" id="wallet-recharge" data-wallet-form>
      <h2>{copy.recharge_title}</h2>
      <label class="wallet-custom">
        <span>{copy.amount}</span>
        <div><b>{symbol}</b><input name="amount" type="number" min={minimumCents / 100} max={maximumCents / 100} step="1" value={(firstOffer?.amountCents ?? minimumCents) / 100} inputmode="decimal" required /></div>
      </label>
      <div class="wallet-offers" role="radiogroup" aria-label={copy.choose_amount}>
        {offers.map((offer, index) => <button type="button" class:list={["wallet-offer", index === 0 && "is-selected"]} role="radio" aria-checked={index === 0 ? "true" : "false"} data-offer-id={offer.id} data-amount={offer.amountCents / 100} data-credit={offer.creditCents / 100}><strong>{money.format(offer.amountCents / 100)}</strong>{offer.bonusCents ? <span>+ {money.format(offer.bonusCents / 100)}</span> : null}</button>)}
      </div>
      <div class="wallet-summary" aria-live="polite">
        <div><span>{copy.current_balance}</span><strong data-wallet-balance>{wallet.balance}</strong></div>
        <div><span>{copy.recharge_amount}</span><strong data-wallet-recharge-amount>{money.format((firstOffer?.amountCents ?? minimumCents) / 100)}</strong></div>
        <div><span>{copy.after_recharge}</span><strong data-wallet-after-recharge>{money.format((wallet.balanceCents + (firstOffer?.creditCents ?? minimumCents)) / 100)}</strong></div>
      </div>
      <p class="wallet-form-error" data-wallet-error aria-live="polite"></p>
      <Button class="wallet-pay" type="submit" variant="primary" size="large" shape="rounded" fullWidth data-wallet-submit>{copy.add_amount} {money.format((firstOffer?.amountCents ?? minimumCents) / 100)}</Button>
      <p class="wallet-secure">✦ {copy.secure}</p>
    </form>

    <div class="wallet-activity" id="wallet-activity">
      <div class="wallet-activity__heading"><div><p>{copy.recent}</p><h2>{copy.activity}</h2></div><Button href={transactionsHref} variant="link" size="compact">{copy.view_all}</Button></div>
      <div data-wallet-transactions aria-live="polite">
        {transactions.length ? transactions.map((item) => <article class:list={["wallet-transaction", Number(item.amountCents) < 0 && "is-debit"]}><div><span aria-hidden="true">{Number(item.amountCents) < 0 ? "↗" : "↙"}</span><div><strong>{String(item.description)}</strong><small>{formatDate(item.createdAt)}</small></div></div><div><b>{String(item.signedAmount)}</b><small>{copy.balance_after}: {String(item.balanceAfter)}</small></div></article>) : <p class="wallet-empty" data-wallet-empty>{copy.empty}</p>}
      </div>
    </div>
  </section>
</main>

<script is:inline define:vars={{ copy }}>
(() => {
  const root = document.querySelector("[data-wallet-app]"); if (!root) return;
  const form = root.querySelector("[data-wallet-form]"); const input = form?.querySelector("input[name=amount]");
  const error = root.querySelector("[data-wallet-error]"); const submit = root.querySelector("[data-wallet-submit]");
  const rechargeAmount = root.querySelector("[data-wallet-recharge-amount]"); const afterRecharge = root.querySelector("[data-wallet-after-recharge]");
  const noticeAction = root.querySelector("[data-wallet-notice-action]");
  const isRetryVisibleState = root.dataset.state === "failed" || root.dataset.state === "cancelled";
  const formatter = new Intl.NumberFormat(root.dataset.locale || "en", { style: "currency", currency: root.dataset.currency || "USD", minimumFractionDigits: 0, maximumFractionDigits: 2 });
  const firstOffer = root.querySelector("[data-offer-id]");
  let offerId = firstOffer?.dataset.offerId || ""; let credit = Number(firstOffer?.dataset.credit) || Number(input?.value) || 0; let requestKey = crypto.randomUUID();
  const readPayload = async (response) => {
    const text = await response.text();
    if (!text) return {};
    try { return JSON.parse(text); }
    catch { return { message: text.trim().startsWith("<") ? copy.failed_body : text.trim().slice(0, 240) }; }
  };
  const formatClientDate = (value) => {
    if (!value) return "";
    try { return new Intl.DateTimeFormat(root.dataset.locale || "en", { dateStyle: "medium", timeStyle: "short" }).format(new Date(String(value))); }
    catch { return new Date(String(value)).toLocaleString(); }
  };
  const buildTransaction = (item) => {
    const article = document.createElement("article"); article.className = `wallet-transaction${Number(item.amountCents || 0) < 0 ? " is-debit" : ""}`;
    const details = document.createElement("div"); const icon = document.createElement("span"); icon.setAttribute("aria-hidden", "true"); icon.textContent = Number(item.amountCents || 0) < 0 ? "↗" : "↙";
    const text = document.createElement("div"); const title = document.createElement("strong"); title.textContent = String(item.description || "");
    const date = document.createElement("small"); date.textContent = formatClientDate(item.createdAt); text.append(title, date); details.append(icon, text);
    const amounts = document.createElement("div"); const signed = document.createElement("b"); signed.textContent = String(item.signedAmount || item.amount || "");
    const balance = document.createElement("small"); balance.textContent = `${copy.balance_after}: ${String(item.balanceAfter || "")}`; amounts.append(signed, balance); article.append(details, amounts);
    return article;
  };
  const renderTransactions = (items) => {
    const container = root.querySelector("[data-wallet-transactions]"); if (!container) return;
    container.replaceChildren(); const limit = Math.max(1, Number(root.dataset.recentLimit) || 8); const recent = Array.isArray(items) ? items.slice(0, limit) : [];
    if (!recent.length) { const empty = document.createElement("p"); empty.className = "wallet-empty"; empty.dataset.walletEmpty = ""; empty.textContent = copy.empty; container.append(empty); return; }
    recent.forEach((item) => container.append(buildTransaction(item)));
  };
  const updateSummary = () => { const amount = Number(input.value) || 0; const balanceCents = Number(root.dataset.walletBalanceCents || "0"); rechargeAmount.textContent = formatter.format(amount); afterRecharge.textContent = formatter.format(balanceCents / 100 + credit); submit.querySelector("span").textContent = `${copy.add_amount} ${formatter.format(amount)}`; };
  const resetSubmitButton = () => {
    if (!(submit instanceof HTMLButtonElement)) return;
    submit.disabled = false;
    submit.removeAttribute("aria-busy");
    submit.removeAttribute("data-loading");
    updateSummary();
  };
  const syncWalletNoticeAction = () => {
    if (noticeAction) noticeAction.hidden = !isRetryVisibleState;
  };
  resetSubmitButton();
  syncWalletNoticeAction();
  const restoreWalletActionState = () => {
    resetSubmitButton();
    syncWalletNoticeAction();
  };
  window.addEventListener("pageshow", restoreWalletActionState);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      restoreWalletActionState();
    }
  });
  root.querySelectorAll("[data-offer-id]").forEach((button) => button.addEventListener("click", () => {
    root.querySelectorAll("[data-offer-id]").forEach((item) => { item.classList.remove("is-selected"); item.setAttribute("aria-checked", "false"); });
    button.classList.add("is-selected"); button.setAttribute("aria-checked", "true"); offerId = button.dataset.offerId || ""; input.value = button.dataset.amount || ""; credit = Number(button.dataset.credit) || Number(input.value); updateSummary();
  }));
  input?.addEventListener("input", () => { offerId = ""; credit = Number(input.value) || 0; root.querySelectorAll("[data-offer-id]").forEach((item) => { item.classList.remove("is-selected"); item.setAttribute("aria-checked", "false"); }); updateSummary(); });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault(); error.textContent = ""; const amount = Number(input.value);
    if (!Number.isFinite(amount) || amount * 100 < Number(root.dataset.minimumCents) || amount * 100 > Number(root.dataset.maximumCents)) { error.textContent = copy.minimum; return; }
    submit.disabled = true; submit.querySelector("span").textContent = copy.preparing;
    try {
      const response = await fetch("/api/wallet/recharges", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json", "x-astropages-customer-csrf": root.dataset.csrf || "" }, body: JSON.stringify({ amount, offerId: offerId || undefined, requestKey, locale: root.dataset.locale }) });
      const payload = await readPayload(response); if (!response.ok || !payload?.data?.checkoutUrl) throw new Error(payload?.message || copy.failed_body);
      requestKey = crypto.randomUUID(); window.location.assign(payload.data.checkoutUrl);
    } catch (reason) { error.textContent = reason instanceof Error ? reason.message : copy.failed_body; submit.disabled = false; updateSummary(); }
  });
  if (root.dataset.state === "verifying" && root.dataset.paymentProvider === "stripe") {
    const notice = root.querySelector("[data-wallet-notice]");
    const noticeTitle = root.querySelector("[data-wallet-notice-title]");
    const noticeBody = root.querySelector("[data-wallet-notice-body]");
    const noticeIcon = root.querySelector(".wallet-notice__icon");
    const noticeAction = root.querySelector("[data-wallet-notice-action]");
    if (noticeTitle) noticeTitle.textContent = copy.verifying;
    if (noticeBody) noticeBody.textContent = copy.verifying;
    if (notice) notice.classList.remove("is-error");
    if (noticeIcon) noticeIcon.textContent = "✓";
    const pollPaymentStatus = async (rechargeId, attemptsLeft = 20) => {
      if (attemptsLeft <= 0) {
        if (noticeBody) noticeBody.textContent = "Payment is processing. Your wallet balance will update shortly once confirmed.";
        if (noticeIcon) noticeIcon.textContent = "⌛";
        return;
      }
      try {
        const response = await fetch(`/api/astropages/generated-site/payments/status?payableType=wallet_recharge&payableId=${encodeURIComponent(rechargeId)}`, { credentials: "same-origin" });
        const payload = await readPayload(response);
        const paymentStatus = payload?.data?.paymentState;
        if (paymentStatus === "paid") {
          const summaryResponse = await fetch(`/api/wallet/summary?locale=${encodeURIComponent(root.dataset.locale || "en")}`, { credentials: "same-origin" });
          const summaryData = await readPayload(summaryResponse);
          if (summaryData?.data?.wallet) {
            root.dataset.walletBalanceCents = String(summaryData.data.wallet.balanceCents || 0);
            document.querySelectorAll("[data-wallet-balance]").forEach((node) => { node.textContent = summaryData.data.wallet.balance; });
            const main = root.querySelector("[data-wallet-balance-main]"); if (main) main.textContent = summaryData.data.wallet.balance;
            renderTransactions(summaryData.data.transactions);
            updateSummary();
          }
          if (noticeTitle) noticeTitle.textContent = copy.success_title;
          if (noticeBody) noticeBody.textContent = copy.success_body;
          if (noticeAction) noticeAction.hidden = true;
          if (noticeIcon) noticeIcon.textContent = "✓";
          history.replaceState({}, "", new URL(window.location.href).pathname + (root.dataset.locale !== "en" ? `?locale=${root.dataset.locale}` : ""));
          return;
        }
        if (paymentStatus === "failed" || paymentStatus === "expired") throw new Error(copy.failed_body);
        window.setTimeout(() => { void pollPaymentStatus(rechargeId, attemptsLeft - 1); }, 1500);
      } catch (reason) {
        if (noticeTitle) noticeTitle.textContent = copy.failed_title;
        if (noticeBody) noticeBody.textContent = reason instanceof Error ? reason.message : copy.failed_body;
        if (notice) notice.classList.add("is-error");
        if (noticeIcon) noticeIcon.textContent = "!";
        if (noticeAction) noticeAction.hidden = false;
      }
    };
    fetch("/api/astropages/generated-site/payments/stripe/wallet-confirm", {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "content-type": "application/json",
        "x-astropages-customer-csrf": root.dataset.csrf || "",
      },
      body: JSON.stringify({
        rechargeId: root.dataset.rechargeId,
        attemptId: root.dataset.attemptId,
        sessionId: root.dataset.sessionId,
        locale: root.dataset.locale,
      }),
    })
      .then(async (response) => {
        const payload = await readPayload(response);
        if (response.status === 202) {
          if (noticeTitle) noticeTitle.textContent = copy.verifying;
          if (noticeBody) noticeBody.textContent = payload?.message || copy.verifying;
          if (notice) notice.classList.remove("is-error");
          if (noticeIcon) noticeIcon.textContent = "✓";
          if (noticeAction) noticeAction.hidden = true;
          void pollPaymentStatus(root.dataset.rechargeId);
          return;
        }
        if (!response.ok || !payload?.data?.wallet) {
          throw new Error(payload?.message || copy.failed_body);
        }
        document.querySelectorAll("[data-wallet-balance]").forEach((node) => {
          node.textContent = payload.data.wallet.balance;
        });
        root.querySelector("[data-wallet-balance-main]").textContent = payload.data.wallet.balance;
        renderTransactions(payload.data.transactions);
        updateSummary();
        if (noticeTitle) noticeTitle.textContent = copy.success_title;
        if (noticeBody) noticeBody.textContent = copy.success_body;
        if (notice) notice.classList.remove("is-error");
        if (noticeIcon) noticeIcon.textContent = "✓";
        if (noticeAction) noticeAction.hidden = true;
        history.replaceState({}, "", new URL(window.location.href).pathname + (root.dataset.locale !== "en" ? `?locale=${root.dataset.locale}` : ""));
      })
      .catch((reason) => {
        if (noticeTitle) noticeTitle.textContent = copy.failed_title;
        if (noticeBody) noticeBody.textContent = reason instanceof Error ? reason.message : copy.failed_body;
        if (notice) notice.classList.add("is-error");
        if (noticeIcon) noticeIcon.textContent = "!";
        if (noticeAction) noticeAction.hidden = false;
      });
  }
  if (root.dataset.state === "verifying" && root.dataset.paymentProvider === "razorpay") {
    const notice = root.querySelector("[data-wallet-notice]");
    const noticeTitle = root.querySelector("[data-wallet-notice-title]");
    const noticeBody = root.querySelector("[data-wallet-notice-body]");
    const reconcile = async () => {
      for (let attempt = 0; attempt < 8; attempt += 1) {
        const response = await fetch("/api/astropages/generated-site/payments/status", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json", "x-astropages-customer-csrf": root.dataset.csrf || "" }, body: JSON.stringify({ payableType: "wallet_recharge", payableId: root.dataset.rechargeId, attemptId: root.dataset.attemptId }) });
        const payload = await readPayload(response);
        if (payload?.data?.paid) {
          const summaryResponse = await fetch(`/api/wallet/summary?locale=${encodeURIComponent(root.dataset.locale || "en")}`, { credentials: "same-origin" });
          const summary = await readPayload(summaryResponse);
          if (!summaryResponse.ok || !summary?.data?.wallet) throw new Error(summary?.message || copy.failed_body);
          root.dataset.walletBalanceCents = String(summary.data.wallet.balanceCents || 0);
          document.querySelectorAll("[data-wallet-balance]").forEach((node) => { node.textContent = summary.data.wallet.balance; });
          const main = root.querySelector("[data-wallet-balance-main]"); if (main) main.textContent = summary.data.wallet.balance;
          renderTransactions(summary.data.transactions); updateSummary();
          if (noticeTitle) noticeTitle.textContent = copy.success_title; if (noticeBody) noticeBody.textContent = copy.success_body;
          history.replaceState({}, "", new URL(window.location.href).pathname);
          return;
        }
        await new Promise((resolve) => window.setTimeout(resolve, 1000));
      }
      if (noticeTitle) noticeTitle.textContent = copy.verifying; if (noticeBody) noticeBody.textContent = "Payment is still awaiting Razorpay webhook confirmation.";
      if (notice) notice.classList.remove("is-error");
    };
    void reconcile().catch((reason) => { if (noticeTitle) noticeTitle.textContent = copy.failed_title; if (noticeBody) noticeBody.textContent = reason instanceof Error ? reason.message : copy.failed_body; if (notice) notice.classList.add("is-error"); });
  }
})();
</script>
