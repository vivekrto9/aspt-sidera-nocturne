---
import "../../styles/shared/select-field.css";

type SelectFieldDensity = "standard" | "compact";
type SelectFieldPresentation = "native" | "popover";

export type SelectFieldOption = {
  value: string | number;
  label: string;
  disabled?: boolean;
  editAttributes?: Record<string, string>;
};

type Props = {
  options?: readonly SelectFieldOption[];
  value?: string | number;
  placeholder?: string;
  id?: string;
  name?: string;
  autocomplete?: string;
  required?: boolean;
  disabled?: boolean;
  autofocus?: boolean;
  form?: string;
  density?: SelectFieldDensity;
  presentation?: SelectFieldPresentation;
  ariaLabel?: string;
  ariaDescribedby?: string;
  invalid?: boolean;
  class?: string;
  [attribute: string]: unknown;
};

const {
  options,
  value,
  placeholder,
  id,
  name,
  autocomplete,
  required = false,
  disabled = false,
  autofocus = false,
  form,
  density = "standard",
  presentation = "native",
  ariaLabel,
  ariaDescribedby,
  invalid = false,
  class: className,
  ...selectAttributes
} = Astro.props as Props;

const classes = [
  "sidera-select-field",
  `sidera-select-field--${density}`,
  className,
]
  .filter(Boolean)
  .join(" ");

const selectedValue = value === undefined ? undefined : String(value);
const firstEnabledOption = options?.find((option) => !option.disabled);
const effectiveSelectedValue =
  selectedValue ?? (placeholder ? "" : String(firstEnabledOption?.value ?? ""));
const selectedOption = options?.find(
  (option) => String(option.value) === effectiveSelectedValue,
);
const selectedLabel = selectedOption?.label ?? placeholder ?? ariaLabel ?? "";
const usePopover = presentation === "popover" && Boolean(options?.length);
---

{
  usePopover ? (
    <details
      class="sidera-select-popover"
      data-select-popover
      data-select-disabled={disabled ? "true" : "false"}
    >
      <summary
        class={classes}
        aria-label={ariaLabel ? `${ariaLabel}: ${selectedLabel}` : selectedLabel}
        aria-describedby={ariaDescribedby}
        aria-invalid={invalid ? "true" : undefined}
        aria-disabled={disabled ? "true" : undefined}
        tabindex={disabled ? -1 : undefined}
        data-select-trigger
      >
        <span data-select-label>{selectedLabel}</span>
      </summary>

      <div
        class="sidera-select-popover__menu"
        role="listbox"
        aria-label={ariaLabel}
        data-select-menu
      >
        {options?.map((option) => (
          <button
            class="sidera-select-popover__option"
            type="button"
            role="option"
            aria-selected={
              effectiveSelectedValue === String(option.value) ? "true" : "false"
            }
            disabled={option.disabled}
            data-select-option
            data-select-value={String(option.value)}
            data-select-label-value={option.label}
          >
            <span {...option.editAttributes}>{option.label}</span>
          </button>
        ))}
      </div>

      <select
        {...selectAttributes}
        class="sidera-select-popover__native"
        id={id}
        name={name}
        autocomplete={autocomplete}
        required={required}
        disabled={disabled}
        autofocus={autofocus}
        form={form}
        aria-hidden="true"
        tabindex="-1"
        data-select-native
      >
        {placeholder ? (
          <option
            value=""
            disabled
            selected={effectiveSelectedValue === ""}
          >
            {placeholder}
          </option>
        ) : null}
        {options?.map((option) => (
          <option
            value={option.value}
            disabled={option.disabled}
            selected={effectiveSelectedValue === String(option.value)}
          >
            {option.label}
          </option>
        ))}
      </select>
    </details>
  ) : (
    <select
      {...selectAttributes}
      class={classes}
      id={id}
      name={name}
      autocomplete={autocomplete}
      required={required}
      disabled={disabled}
      autofocus={autofocus}
      form={form}
      aria-label={ariaLabel}
      aria-describedby={ariaDescribedby}
      aria-invalid={invalid ? "true" : undefined}
    >
      {placeholder ? (
        <option value="" disabled selected={selectedValue === undefined || selectedValue === ""}>
          {placeholder}
        </option>
      ) : null}
      {options
        ? options.map((option) => (
            <option
              value={option.value}
              disabled={option.disabled}
              selected={selectedValue === String(option.value)}
            >
              {option.label}
            </option>
          ))
        : <slot />}
    </select>
  )
}

<script>
  const initializeSelectPopover = (root: HTMLDetailsElement) => {
    if (root.dataset.selectPopoverReady === "true") return;

    const trigger = root.querySelector<HTMLElement>("[data-select-trigger]");
    const label = root.querySelector<HTMLElement>("[data-select-label]");
    const nativeSelect = root.querySelector<HTMLSelectElement>("[data-select-native]");
    const options = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-select-option]"),
    );

    if (!trigger || !label || !nativeSelect || options.length === 0) return;

    const enabledOptions = () => options.filter((option) => !option.disabled);
    const selectedIndex = () =>
      enabledOptions().findIndex((option) => option.getAttribute("aria-selected") === "true");
    const synchronizeDisabledState = () => {
      const isDisabled = nativeSelect.disabled;
      root.dataset.selectDisabled = String(isDisabled);
      trigger.setAttribute("aria-disabled", String(isDisabled));
      trigger.tabIndex = isDisabled ? -1 : 0;
      if (isDisabled) root.open = false;
    };
    const synchronizeSelection = () => {
      const selected = options.find(
        (option) => option.dataset.selectValue === nativeSelect.value,
      );
      if (!selected) return;

      const nextLabel =
        selected.dataset.selectLabelValue ?? selected.textContent?.trim() ?? "";
      label.textContent = nextLabel;
      options.forEach((candidate) => {
        candidate.setAttribute("aria-selected", String(candidate === selected));
      });
      const accessibleLabel = trigger.getAttribute("aria-label")?.split(":")[0];
      trigger.setAttribute(
        "aria-label",
        accessibleLabel ? `${accessibleLabel}: ${nextLabel}` : nextLabel,
      );
    };
    const chooseOption = (option: HTMLButtonElement) => {
      if (option.disabled) return;

      nativeSelect.value = option.dataset.selectValue ?? "";
      nativeSelect.dispatchEvent(new Event("input", { bubbles: true }));
      nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
      root.open = false;
      trigger.focus();
    };
    const focusOption = (index: number) => {
      const available = enabledOptions();
      const option = available[(index + available.length) % available.length];
      option?.focus();
    };

    trigger.addEventListener("click", (event) => {
      if (nativeSelect.disabled) event.preventDefault();
    });
    root.addEventListener("toggle", () => {
      if (root.open) {
        const index = selectedIndex();
        focusOption(index < 0 ? 0 : index);
      }
    });
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        root.open = false;
        trigger.focus();
        return;
      }

      const available = enabledOptions();
      const currentIndex = available.findIndex(
        (option) => option === document.activeElement,
      );
      const activeOption = available[currentIndex];
      if ((event.key === "Enter" || event.key === " ") && activeOption) {
        event.preventDefault();
        chooseOption(activeOption);
      } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        const direction = event.key === "ArrowDown" ? 1 : -1;
        focusOption(currentIndex < 0 ? selectedIndex() : currentIndex + direction);
      } else if (event.key === "Home") {
        event.preventDefault();
        focusOption(0);
      } else if (event.key === "End") {
        event.preventDefault();
        focusOption(available.length - 1);
      }
    });
    options.forEach((option) => {
      option.addEventListener("click", () => chooseOption(option));
    });
    nativeSelect.addEventListener("change", synchronizeSelection);
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) root.open = false;
    });
    new MutationObserver(synchronizeDisabledState).observe(nativeSelect, {
      attributes: true,
      attributeFilter: ["disabled"],
    });

    root.dataset.selectPopoverReady = "true";
    synchronizeDisabledState();
  };

  document
    .querySelectorAll<HTMLDetailsElement>("[data-select-popover]")
    .forEach(initializeSelectPopover);
</script>
