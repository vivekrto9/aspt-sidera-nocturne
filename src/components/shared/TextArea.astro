---
import "../../styles/shared/text-area.css";

type TextAreaTone = "default" | "inverse";
type TextAreaSize = "compact" | "standard";
type TextAreaWrap = "hard" | "soft" | "off";

type Props = {
  id?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  minlength?: number;
  maxlength?: number;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  autofocus?: boolean;
  spellcheck?: boolean;
  form?: string;
  wrap?: TextAreaWrap;
  tone?: TextAreaTone;
  size?: TextAreaSize;
  ariaLabel?: string;
  ariaDescribedby?: string;
  invalid?: boolean;
  class?: string;
  [attribute: string]: unknown;
};

const {
  id,
  name,
  value,
  placeholder,
  rows,
  minlength,
  maxlength,
  required = false,
  disabled = false,
  readonly: readOnly = false,
  autofocus = false,
  spellcheck,
  form,
  wrap,
  tone = "default",
  size = "standard",
  ariaLabel,
  ariaDescribedby,
  invalid = false,
  class: className,
  ...textAreaAttributes
} = Astro.props as Props;

const classes = [
  "sidera-text-area",
  `sidera-text-area--${tone}`,
  `sidera-text-area--${size}`,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<textarea
  {...textAreaAttributes}
  class={classes}
  id={id}
  name={name}
  placeholder={placeholder}
  rows={rows}
  minlength={minlength}
  maxlength={maxlength}
  required={required}
  disabled={disabled}
  readonly={readOnly}
  autofocus={autofocus}
  spellcheck={spellcheck}
  form={form}
  wrap={wrap}
  aria-label={ariaLabel}
  aria-describedby={ariaDescribedby}
  aria-invalid={invalid ? "true" : undefined}
>{value}</textarea>
