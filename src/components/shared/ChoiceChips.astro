---
import "../../styles/shared/choice-chips.css";

type ChoiceMode = "single" | "multiple";
type ChoiceShape = "pill" | "rounded";
type ChoiceSize = "compact" | "standard";
type ChoiceTone = "default" | "inverse";

type ChoiceOption = {
  value: string;
  label: string;
  disabled?: boolean;
  editAttributes?: Record<string, string>;
};

type Props = {
  id: string;
  name: string;
  label: string;
  options: ChoiceOption[];
  mode?: ChoiceMode;
  value?: string;
  values?: string[];
  shape?: ChoiceShape;
  size?: ChoiceSize;
  tone?: ChoiceTone;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  hideLabel?: boolean;
  helpText?: string;
  errorText?: string;
  form?: string;
  class?: string;
  labelEditAttributes?: Record<string, string>;
  helpEditAttributes?: Record<string, string>;
  errorEditAttributes?: Record<string, string>;
};

const {
  id,
  name,
  label,
  options,
  mode = "single",
  value,
  values = [],
  shape = "pill",
  size = "standard",
  tone = "default",
  required = false,
  disabled = false,
  invalid = false,
  hideLabel = false,
  helpText,
  errorText,
  form,
  class: className,
  labelEditAttributes = {},
  helpEditAttributes = {},
  errorEditAttributes = {},
} = Astro.props as Props;

const inputType = mode === "single" ? "radio" : "checkbox";
const helpId = helpText ? `${id}-help` : undefined;
const errorId = errorText ? `${id}-error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(" ") || undefined;
const classes = [
  "sidera-choice-chips",
  `sidera-choice-chips--${shape}`,
  `sidera-choice-chips--${size}`,
  `sidera-choice-chips--tone-${tone}`,
  invalid && "sidera-choice-chips--invalid",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<fieldset
  id={id}
  class={classes}
  disabled={disabled}
  aria-describedby={describedBy}
  aria-invalid={invalid || Boolean(errorText) ? "true" : undefined}
  aria-required={required ? "true" : undefined}
>
  <legend
    class:list={[
      "sidera-choice-chips__legend",
      hideLabel && "sidera-choice-chips__legend--hidden",
    ]}
    {...labelEditAttributes}
  >
    {label}
    {required && <span class="sidera-choice-chips__required" aria-hidden="true"> *</span>}
  </legend>

  <div class="sidera-choice-chips__options">
    {
      options.map((option, index) => {
        const optionId = `${id}-${index}`;
        const checked =
          mode === "single" ? value === option.value : values.includes(option.value);

        return (
          <label class="sidera-choice-chips__option" for={optionId}>
            <input
              class="sidera-choice-chips__input"
              id={optionId}
              type={inputType}
              name={name}
              value={option.value}
              checked={checked}
              disabled={option.disabled}
              required={mode === "single" ? required : undefined}
              form={form}
            />
            <span class="sidera-choice-chips__chip" {...option.editAttributes}>
              {option.label}
            </span>
          </label>
        );
      })
    }
  </div>

  {
    helpText && (
      <p
        class="sidera-choice-chips__message sidera-choice-chips__message--help"
        id={helpId}
        {...helpEditAttributes}
      >
        {helpText}
      </p>
    )
  }

  <p
    class="sidera-choice-chips__message sidera-choice-chips__message--error"
    id={errorId}
    role={errorText ? "alert" : undefined}
    hidden={!errorText}
    {...errorEditAttributes}
  >
    {errorText}
  </p>
</fieldset>
