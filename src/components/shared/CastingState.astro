---
import LoadingIndicator from "./LoadingIndicator.astro";
import "../../styles/shared/casting-state.css";

type CastingVisual = "single" | "transit" | "synastry";
type CastingHeight = "embedded" | "viewport";
type HeadingTag = "h1" | "h2" | "h3";

type Props = {
  title: string;
  statusLabel: string;
  summary?: string;
  visual?: CastingVisual;
  height?: CastingHeight;
  headingTag?: HeadingTag;
  showAmbient?: boolean;
  titleEditAttributes?: Record<string, string>;
  statusEditAttributes?: Record<string, string>;
  summaryEditAttributes?: Record<string, string>;
  class?: string;
  [attribute: string]: unknown;
};

const {
  title,
  statusLabel,
  summary,
  visual = "single",
  height = "viewport",
  headingTag = "h2",
  showAmbient = true,
  titleEditAttributes = {},
  statusEditAttributes = {},
  summaryEditAttributes = {},
  class: className,
  ...stateAttributes
} = Astro.props as Props;

const zodiacGlyphs = ["♈", "♉", "♊", "♋", "♌", "♍", "♎", "♏", "♐", "♑", "♒", "♓"];
const zodiacPositions = zodiacGlyphs.map((glyph, index) => {
  const angle = ((index * 30 - 90) * Math.PI) / 180;

  return {
    glyph,
    x: 130 + Math.cos(angle) * 105,
    y: 130 + Math.sin(angle) * 105,
  };
});
const hasVisualSlot = Astro.slots.has("visual");
const HeadingElement = headingTag;
const classes = [
  "sidera-casting-state",
  `sidera-casting-state--${height}`,
  `sidera-casting-state--${visual}`,
  showAmbient && "sidera-casting-state--ambient",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<section {...stateAttributes} class={classes} aria-busy="true">
  <div class="sidera-casting-state__content">
    <div class="sidera-casting-state__visual" aria-hidden="true">
      {
        hasVisualSlot ? (
          <slot name="visual" />
        ) : visual === "synastry" ? (
          <svg viewBox="0 0 340 240" role="presentation">
            <g class="sidera-casting-state__synastry-ring sidera-casting-state__synastry-ring--first">
              <circle cx="150" cy="120" r="92" />
              <circle cx="150" cy="120" r="72" class="sidera-casting-state__dashed" />
            </g>
            <g class="sidera-casting-state__synastry-ring sidera-casting-state__synastry-ring--second">
              <circle cx="190" cy="120" r="92" />
              <circle cx="190" cy="120" r="72" class="sidera-casting-state__dashed" />
            </g>
          </svg>
        ) : (
          <svg viewBox="0 0 260 260" role="presentation">
            <g class="sidera-casting-state__ring sidera-casting-state__ring--outer">
              <circle cx="130" cy="130" r="122" />
              {zodiacPositions.map((position) => (
                <text
                  x={position.x}
                  y={position.y}
                  text-anchor="middle"
                  dominant-baseline="central"
                >
                  {position.glyph}
                </text>
              ))}
            </g>
            <g
              class:list={[
                "sidera-casting-state__ring",
                "sidera-casting-state__ring--inner",
                visual === "transit" && "sidera-casting-state__ring--reverse",
              ]}
            >
              <circle cx="130" cy="130" r="90" class="sidera-casting-state__dashed" />
            </g>
            <circle class="sidera-casting-state__core" cx="130" cy="130" r="28" />
            <text
              class="sidera-casting-state__core-glyph"
              x="130"
              y="131"
              text-anchor="middle"
              dominant-baseline="central"
            >
              ☉
            </text>
          </svg>
        )
      }
    </div>

    <HeadingElement class="sidera-casting-state__title" {...titleEditAttributes}>
      {title}
    </HeadingElement>
    <LoadingIndicator
      label={statusLabel}
      size="compact"
      tone="inverse"
      ariaLive="polite"
      class="sidera-casting-state__indicator"
      editAttributes={statusEditAttributes}
    />
    {
      summary ? (
        <p class="sidera-casting-state__summary" {...summaryEditAttributes}>
          {summary}
        </p>
      ) : null
    }
  </div>
</section>
