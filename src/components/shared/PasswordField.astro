---
import FormField from "./FormField.astro";
import IconButton from "./IconButton.astro";
import TextField from "./TextField.astro";
import "../../styles/shared/password-field.css";

type Props = {
  id: string;
  label: string;
  showLabel: string;
  hideLabel: string;
  name?: string;
  value?: string;
  placeholder?: string;
  autocomplete?: string;
  minlength?: number;
  maxlength?: number;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  autofocus?: boolean;
  invalid?: boolean;
  helpText?: string;
  errorText?: string;
  optionalText?: string;
  ariaDescribedby?: string;
  form?: string;
  class?: string;
  inputClass?: string;
  inputAttributes?: Record<string, unknown>;
  labelEditAttributes?: Record<string, string>;
  helpEditAttributes?: Record<string, string>;
  errorEditAttributes?: Record<string, string>;
};

const {
  id,
  label,
  showLabel,
  hideLabel,
  name,
  value,
  placeholder,
  autocomplete,
  minlength,
  maxlength,
  required = false,
  disabled = false,
  readonly: readOnly = false,
  autofocus = false,
  invalid = false,
  helpText,
  errorText,
  optionalText,
  ariaDescribedby,
  form,
  class: className,
  inputClass,
  inputAttributes = {},
  labelEditAttributes = {},
  helpEditAttributes = {},
  errorEditAttributes = {},
} = Astro.props as Props;

const describedBy =
  ariaDescribedby ??
  [helpText ? `${id}-help` : undefined, `${id}-error`].filter(Boolean).join(" ");
const classes = ["sidera-password-field", className].filter(Boolean).join(" ");
---

<FormField
  class={classes}
  controlId={id}
  label={label}
  helpText={helpText}
  errorText={errorText}
  optionalText={optionalText}
  required={required}
  labelEditAttributes={labelEditAttributes}
  helpEditAttributes={helpEditAttributes}
  errorEditAttributes={errorEditAttributes}
  data-password-field=""
  data-password-show-label={showLabel}
  data-password-hide-label={hideLabel}
>
  <div class="sidera-password-field__control">
    <TextField
      {...inputAttributes}
      class={["sidera-password-field__input", inputClass].filter(Boolean).join(" ")}
      type="password"
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      autocomplete={autocomplete}
      minlength={minlength}
      maxlength={maxlength}
      required={required}
      disabled={disabled}
      readonly={readOnly}
      autofocus={autofocus}
      spellcheck={false}
      form={form}
      ariaDescribedby={describedBy}
      invalid={invalid || Boolean(errorText)}
    />

    <IconButton
      class="sidera-password-field__toggle"
      ariaLabel={showLabel}
      variant="ghost"
      size="compact"
      shape="circle"
      type="button"
      disabled={disabled}
      pressed={false}
      controls={id}
    >
      <svg
        class="sidera-password-field__icon sidera-password-field__icon--show"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
        <circle cx="12" cy="12" r="2.6"></circle>
      </svg>
      <svg
        class="sidera-password-field__icon sidera-password-field__icon--hide"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 3l18 18"></path>
        <path d="M10.6 6.1A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-2.1 2.8"></path>
        <path d="M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6c1.6 0 3-.4 4.2-1"></path>
      </svg>
    </IconButton>
  </div>
</FormField>

<script>
  const initializePasswordFields = () => {
    document.querySelectorAll<HTMLElement>("[data-password-field]").forEach((root) => {
      if (root.dataset.passwordReady === "true") return;

      const input = root.querySelector<HTMLInputElement>(".sidera-password-field__input");
      const toggle = root.querySelector<HTMLButtonElement>(".sidera-password-field__toggle");
      if (!input || !toggle) return;

      const showLabel = root.dataset.passwordShowLabel || toggle.getAttribute("aria-label") || "";
      const hideLabel = root.dataset.passwordHideLabel || showLabel;

      toggle.addEventListener("click", () => {
        const visible = input.type === "password";
        input.type = visible ? "text" : "password";
        root.toggleAttribute("data-password-visible", visible);
        toggle.setAttribute("aria-pressed", String(visible));
        toggle.setAttribute("aria-label", visible ? hideLabel : showLabel);
      });

      root.dataset.passwordReady = "true";
    });
  };

  initializePasswordFields();
  document.addEventListener("astro:page-load", initializePasswordFields);
</script>
