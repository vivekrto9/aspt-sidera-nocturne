---
import type { BuilderEditAttributes } from "../builder/builder.ts";
import { loadPublicPageContent } from "../builder/public-page.ts";
import { getAuthForgotPasswordFormCopy } from "../data/locale/auth/sections/forgot-password-form.ts";
import AuthShell from "../components/shared/AuthShell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthForgotPasswordForm from "../components/auth/sections/AuthForgotPasswordForm.astro";
import { getForgotPasswordShellCopy } from "../data/locale/auth/common/forgot-password-shell.ts";

export const prerender = false;

const {
  content,
  locale,
  builder,
  builderPage,
  chromePage,
  reviewTargets,
  builderEdit,
} = await loadPublicPageContent(Astro, "forgot-password");
const shellCopy = getForgotPasswordShellCopy(locale);
const baseFormCopy = getAuthForgotPasswordFormCopy(locale);
const formCopy = {
  ...baseFormCopy,
  heading: content.forgot_password_form_heading,
  subheading: content.forgot_password_form_subheading,
  emailLabel: content.forgot_password_email_label,
  emailPlaceholder: content.forgot_password_email_placeholder,
  submitLabel: content.forgot_password_submit_label,
  loadingLabel: content.forgot_password_loading_label,
  successLabel: content.forgot_password_success_label,
  resentSuccessLabel: content.forgot_password_resent_success_label,
  invalidEmailLabel: content.forgot_password_invalid_email_label,
  resendPrompt: content.forgot_password_resend_prompt,
  resendLabel: content.forgot_password_resend_label,
  resendCountdownLabel: content.forgot_password_resend_countdown_label,
  resendReadyLabel: content.forgot_password_resend_ready_label,
  loginPrompt: content.forgot_password_login_prompt,
  loginLabel: content.forgot_password_login_label,
};

const componentEditAttributes = (
  attributes: BuilderEditAttributes,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(attributes)
      .filter((entry): entry is [string, string | true] => entry[1] !== undefined)
      .map(([key, value]) => [key, value === true ? "true" : value]),
  );

const panelPerks = [
  {
    icon: "✦",
    label: content.forgot_password_proof_1_label,
    labelEditAttributes: componentEditAttributes(
      builderEdit("forgot_password_proof_1_label"),
    ),
  },
  {
    icon: "✦",
    label: content.forgot_password_proof_2_label,
    labelEditAttributes: componentEditAttributes(
      builderEdit("forgot_password_proof_2_label"),
    ),
  },
];

const seoContent = {
  seo_title: content.seo_title,
  seo_description: content.seo_description,
  seo_canonical_path: content.seo_canonical_path,
  seo_robots: content.seo_robots,
  og_title: content.og_title,
  og_description: content.og_description,
  og_image: content.og_image,
  og_image_alt: content.og_image_alt,
  twitter_card: content.twitter_card,
  twitter_title: content.twitter_title,
  twitter_description: content.twitter_description,
  twitter_image: content.twitter_image,
};
---

<BaseLayout
  seo={seoContent}
  bodyClass="sidera-auth-body"
  builderToolbar={{
    launcherEnabled: builder.launcherEnabled,
    studioModeEnabled: builder.studioModeEnabled,
    collection: builder.collection,
    entry: builder.entry,
    locale: builder.locale,
    csrfToken: builder.csrfToken,
    canPublish: builder.canPublish,
    seo: seoContent,
    hasSavedDraft: builderPage.hasSavedDraft || chromePage.hasSavedDraft,
    reviewTargets,
  }}
>
  <AuthShell
    id="forgot-password"
    brandLabel={content.forgot_password_brand_label}
    brandHref="/"
    brandAriaLabel={content.forgot_password_brand_aria_label}
    backLabel={content.forgot_password_back_label}
    backHref="/"
    panelKicker={content.forgot_password_panel_kicker}
    panelTitle={content.forgot_password_panel_title}
    panelDescription={content.forgot_password_panel_description}
    perks={panelPerks}
    formLabel={shellCopy.formLabel}
    locale={locale}
    brandEditAttributes={componentEditAttributes(
      builderEdit("forgot_password_brand_label"),
    )}
    backEditAttributes={componentEditAttributes(
      builderEdit("forgot_password_back_label"),
    )}
    kickerEditAttributes={componentEditAttributes(
      builderEdit("forgot_password_panel_kicker"),
    )}
    titleEditAttributes={componentEditAttributes(
      builderEdit("forgot_password_panel_title"),
    )}
    descriptionEditAttributes={componentEditAttributes(
      builderEdit("forgot_password_panel_description"),
    )}
  >
    <AuthForgotPasswordForm
      copy={formCopy}
      locale={locale}
      editAttributes={(field) =>
        componentEditAttributes(builderEdit(field))
      }
    />
  </AuthShell>
</BaseLayout>
