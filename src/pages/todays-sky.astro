---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPublicPageContent } from "../builder/public-page.ts";
import type { BuilderEditAttributes } from "../builder/builder.ts";
import TodaysSkyPageHeader from "../components/todays-sky/sections/TodaysSkyPageHeader.astro";
import TodaysSkyDateScrubber from "../components/todays-sky/sections/TodaysSkyDateScrubber.astro";
import TodaysSkyMoonAspects from "../components/todays-sky/sections/TodaysSkyMoonAspects.astro";
import TodaysSkyPersonalizedHandoff from "../components/todays-sky/sections/TodaysSkyPersonalizedHandoff.astro";
import TodaysSkyWheelReadingPositions from "../components/todays-sky/sections/TodaysSkyWheelReadingPositions.astro";
import Footer from "../components/shared/Footer.astro";
import Header from "../components/shared/Header.astro";
import EmptyState from "../components/shared/EmptyState.astro";
import {
  activeLocales,
  defaultLocale,
  localizePath,
  type SupportedLocale,
} from "../data/localization-contract.ts";
import { getTodaysSkyMoonAspectsFields } from "../data/locale/todays-sky/sections/moon-and-aspects.ts";
import {
  getTodaysSkyPersonalizedHandoffCopy,
  type TodaysSkyPersonalizedHandoffCopy,
} from "../data/locale/todays-sky/sections/personalized-handoff.ts";
import { getTodaysSkyDateScrubberCopy } from "../data/locale/todays-sky/sections/date-scrubber.ts";
import { getProviderUnavailableCopy } from "../data/provider-unavailable.ts";
import "../styles/todays-sky/todays-sky.css";
import { getSkyForDate } from "../server/aggregator/sky-api.ts";
import { getRuntimeEnv } from "../server/generated-site/request.ts";

export const prerender = false;

const {
  locale,
  content,
  builder,
  builderPage,
  chromePage,
  reviewTargets,
  builderEdit,
  chromeEdit,
} = await loadPublicPageContent(Astro, "todays_sky");

const seoContent = {
  seo_title: content.seo_title,
  seo_description: content.seo_description,
  seo_canonical_path: content.seo_canonical_path,
  seo_robots: content.seo_robots,
  og_title: content.og_title,
  og_description: content.og_description,
  og_image: content.og_image,
  og_image_alt: content.og_image_alt,
  twitter_card: content.twitter_card,
  twitter_title: content.twitter_title,
  twitter_description: content.twitter_description,
  twitter_image: content.twitter_image,
};

const componentEditAttributes = (
  attributes: BuilderEditAttributes,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(attributes)
      .filter((entry): entry is [string, string | true] => entry[1] !== undefined)
      .map(([key, value]) => [key, value === true ? "true" : value]),
  );

const localeHref = (targetLocale: SupportedLocale) => {
  const url = new URL(Astro.request.url);
  if (targetLocale === defaultLocale) {
    if (locale === defaultLocale) {
      url.searchParams.delete("locale");
    } else {
      url.searchParams.set("locale", defaultLocale);
    }
  } else {
    url.searchParams.set("locale", targetLocale);
  }
  return `${url.pathname}${url.search}${url.hash}`;
};

const navigation = [
  {
    label: content.nav_todays_sky,
    href: localizePath("/todays-sky", locale),
    current: true,
    editAttributes: componentEditAttributes(chromeEdit("nav_todays_sky")),
  },
  {
    label: content.nav_charts,
    href: localizePath("/birth-chart", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_charts")),
  },
  {
    label: content.nav_compatibility,
    href: localizePath("/synastry", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_compatibility")),
  },
  {
    label: content.nav_moon,
    href: localizePath("/moon-calendar", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_moon")),
  },
  {
    label: content.nav_horoscope,
    href: localizePath("/daily-horoscope", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_horoscope")),
  },
  {
    label: content.nav_astrologers,
    href: localizePath("/astrologers", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_astrologers")),
  },
  {
    label: content.nav_blog,
    href: localizePath("/blog", locale),
    editAttributes: componentEditAttributes(chromeEdit("nav_blog")),
  },
];

const actions = [
  {
    id: "your-transits",
    label: content.header_action_transits,
    href: localizePath("/transit", locale),
    variant: "ghost" as const,
    editAttributes: componentEditAttributes(builderEdit("header_action_transits")),
  },
  {
    id: "get-chart",
    label: content.action_get_chart,
    href: localizePath("/birth-chart", locale),
    variant: "primary" as const,
    editAttributes: componentEditAttributes(chromeEdit("action_get_chart")),
  },
];

const languageOptions = activeLocales.map((item) => {
  const field = `language_option_${item.code}_label`;
  return {
    code: item.code,
    label: content[field] || item.nativeName,
    href: localeHref(item.code),
    lang: item.code,
    hreflang: item.hreflang,
    editAttributes: componentEditAttributes(chromeEdit(field)),
  };
});

const dateScrubberCopy = getTodaysSkyDateScrubberCopy(locale);
const today = new Date();
today.setHours(12, 0, 0, 0);
const toIsoDate = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
};
const parseIsoDate = (value: string | null) => {
  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
  const parsed = new Date(`${value}T12:00:00`);
  return Number.isNaN(parsed.getTime()) || toIsoDate(parsed) !== value ? null : parsed;
};
const requestedDate = parseIsoDate(Astro.url.searchParams.get("date"));
const requestedOffset = requestedDate
  ? Math.round((requestedDate.getTime() - today.getTime()) / 86_400_000)
  : 0;
const selectedOffset = Math.min(120, Math.max(-30, requestedOffset));
const selectedViewDate = new Date(today);
selectedViewDate.setDate(today.getDate() + selectedOffset);
const selectedDateIso = toIsoDate(selectedViewDate);
const providerSky = await getSkyForDate({
  env: await getRuntimeEnv(Astro),
  date: selectedDateIso,
  locale,
  live: selectedOffset === 0,
}).catch(() => null);
const providerUnavailable = getProviderUnavailableCopy(locale);
const dateHref = (offset: number) => {
  const selectedDate = new Date(today);
  selectedDate.setDate(today.getDate() + Math.min(120, Math.max(-30, offset)));
  const url = new URL(Astro.request.url);
  if (offset === 0) url.searchParams.delete("date");
  else url.searchParams.set("date", toIsoDate(selectedDate));
  return `${url.pathname}${url.search}${url.hash}`;
};
const moonAspectEditAttributes = Object.fromEntries(
  Object.keys(getTodaysSkyMoonAspectsFields(locale)).map((field) => [
    field,
    componentEditAttributes(builderEdit(field)),
  ]),
);
const personalizedHandoffDefaults = getTodaysSkyPersonalizedHandoffCopy(locale);
const personalizedHandoffCopy: TodaysSkyPersonalizedHandoffCopy = {
  sky_handoff_eyebrow:
    content.sky_handoff_eyebrow ?? personalizedHandoffDefaults.sky_handoff_eyebrow,
  sky_handoff_title_prefix:
    content.sky_handoff_title_prefix ??
    personalizedHandoffDefaults.sky_handoff_title_prefix,
  sky_handoff_title_accent:
    content.sky_handoff_title_accent ??
    personalizedHandoffDefaults.sky_handoff_title_accent,
  sky_handoff_title_suffix:
    content.sky_handoff_title_suffix ??
    personalizedHandoffDefaults.sky_handoff_title_suffix,
  sky_handoff_description:
    content.sky_handoff_description ??
    personalizedHandoffDefaults.sky_handoff_description,
  sky_handoff_primary_label:
    content.sky_handoff_primary_label ??
    personalizedHandoffDefaults.sky_handoff_primary_label,
  sky_handoff_secondary_label:
    content.sky_handoff_secondary_label ??
    personalizedHandoffDefaults.sky_handoff_secondary_label,
};
const personalizedHandoffEditAttributes = (
  field: keyof TodaysSkyPersonalizedHandoffCopy,
) => componentEditAttributes(builderEdit(field));

const footerGroups = [
  {
    label: content.footer_group_charts,
    labelEditAttributes: componentEditAttributes(
      chromeEdit("footer_group_charts"),
    ),
    links: [
      ["footer_link_birth_chart", "/birth-chart"],
      ["footer_link_transit", "/transit"],
      ["footer_link_synastry", "/synastry"],
    ].map(([field, path]) => ({
      label: content[field],
      href: localizePath(path, locale),
      editAttributes: componentEditAttributes(chromeEdit(field)),
    })),
  },
  {
    label: content.footer_group_tools,
    labelEditAttributes: componentEditAttributes(
      chromeEdit("footer_group_tools"),
    ),
    links: [
      ["footer_link_todays_sky", "/todays-sky"],
      ["footer_link_moon_calendar", "/moon-calendar"],
      ["footer_link_retrogrades", "/retrogrades"],
      ["footer_link_reports", "/reports"],
    ].map(([field, path]) => ({
      label: content[field],
      href: localizePath(path, locale),
      editAttributes: componentEditAttributes(chromeEdit(field)),
    })),
  },
  {
    label: content.footer_group_learn,
    labelEditAttributes: componentEditAttributes(
      chromeEdit("footer_group_learn"),
    ),
    links: [
      ["footer_link_blog", "/blog"],
      ["footer_link_daily_horoscope", "/daily-horoscope"],
      ["footer_link_glossary", "/glossary"],
      ["footer_link_faq", "/faq"],
    ].map(([field, path]) => ({
      label: content[field],
      href: localizePath(path, locale),
      editAttributes: componentEditAttributes(chromeEdit(field)),
    })),
  },
  {
    label: content.footer_group_company,
    labelEditAttributes: componentEditAttributes(
      chromeEdit("footer_group_company"),
    ),
    links: [
      ["footer_link_about", "/about"],
      ["footer_link_account", "/account"],
      ["footer_link_shop", "/shop"],
    ].map(([field, path]) => ({
      label: content[field],
      href: localizePath(path, locale),
      editAttributes: componentEditAttributes(chromeEdit(field)),
    })),
  },
];
const footerLegalLinks = [
  ["footer_link_privacy", "/privacy"],
  ["footer_link_terms", "/terms"],
].map(([field, path]) => ({
  label: content[field],
  href: localizePath(path, locale),
  editAttributes: componentEditAttributes(chromeEdit(field)),
}));
---

<BaseLayout
  seo={seoContent}
  bodyClass="todays-sky-body"
  builderToolbar={{
    launcherEnabled: builder.launcherEnabled,
    studioModeEnabled: builder.studioModeEnabled,
    collection: builder.collection,
    entry: builder.entry,
    locale: builder.locale,
    csrfToken: builder.csrfToken,
    canPublish: builder.canPublish,
    seo: seoContent,
    hasSavedDraft: builderPage.hasSavedDraft || chromePage.hasSavedDraft,
    reviewTargets,
  }}
>
  <Header
    id="todays-sky-header"
    brandLabel={content.brand_name}
    brandHref={localizePath("/", locale)}
    brandAriaLabel={content.brand_aria_label}
    navigationLabel={content.primary_navigation_label}
    chromeNavigation={{ content, edit: chromeEdit }}
    navigation={navigation}
    actions={actions}
    language={{
      activeLocale: locale,
      options: languageOptions,
      triggerLabel: content.language_trigger_label,
      menuLabel: content.language_menu_label,
    }}
    mobileUtilityActionId="your-transits"
    menuLabel={content.menu_open_label}
    closeMenuLabel={content.menu_close_label}
    brandEditAttributes={componentEditAttributes(chromeEdit("brand_name"))}
  />

  <main class="todays-sky-page">
    <TodaysSkyPageHeader
      eyebrow={content.page_header_eyebrow}
      titleAccent={content.page_header_title_accent}
      titleSuffix={content.page_header_title_suffix}
      metaPrimary={content.page_header_meta_primary}
      metaSecondary={content.page_header_meta_secondary}
      eyebrowEditAttributes={componentEditAttributes(
        builderEdit("page_header_eyebrow"),
      )}
      titleAccentEditAttributes={componentEditAttributes(
        builderEdit("page_header_title_accent"),
      )}
      titleSuffixEditAttributes={componentEditAttributes(
        builderEdit("page_header_title_suffix"),
      )}
      metaPrimaryEditAttributes={componentEditAttributes(
        builderEdit("page_header_meta_primary"),
      )}
      metaSecondaryEditAttributes={componentEditAttributes(
        builderEdit("page_header_meta_secondary"),
      )}
    />
    <div data-todays-sky-dynamic-content style="display: contents;">
    {providerSky ? <>
    <TodaysSkyDateScrubber
      localeTag={locale}
      todayIso={toIsoDate(today)}
      selectedOffset={selectedOffset}
      eyebrow={content.date_scrubber_eyebrow}
      todayAction={content.date_scrubber_today_action}
      todayMarker={content.date_scrubber_today_marker}
      movingNowLabel={content.date_scrubber_moving_now_label}
      navigationLabel={dateScrubberCopy.navigationLabel}
      previousLabel={dateScrubberCopy.previousLabel}
      nextLabel={dateScrubberCopy.nextLabel}
      rangeLabel={dateScrubberCopy.rangeLabel}
      previousHref={dateHref(selectedOffset - 1)}
      nextHref={dateHref(selectedOffset + 1)}
      todayHref={dateHref(0)}
      positions={providerSky.positions}
      eyebrowEditAttributes={componentEditAttributes(
        builderEdit("date_scrubber_eyebrow"),
      )}
      todayActionEditAttributes={componentEditAttributes(
        builderEdit("date_scrubber_today_action"),
      )}
      todayMarkerEditAttributes={componentEditAttributes(
        builderEdit("date_scrubber_today_marker"),
      )}
      movingNowLabelEditAttributes={componentEditAttributes(
        builderEdit("date_scrubber_moving_now_label"),
      )}
    />
    <TodaysSkyWheelReadingPositions
      locale={locale}
      selectedDateIso={selectedDateIso}
      positions={providerSky.positions}
      wheelCaption={content.sky_wheel_caption}
      positionsTitle={content.sky_positions_title}
      positionsCount={content.sky_positions_count}
      wheelCaptionEditAttributes={componentEditAttributes(
        builderEdit("sky_wheel_caption"),
      )}
      positionsTitleEditAttributes={componentEditAttributes(
        builderEdit("sky_positions_title"),
      )}
      positionsCountEditAttributes={componentEditAttributes(
        builderEdit("sky_positions_count"),
      )}
    />
    <TodaysSkyMoonAspects
      locale={locale}
      selectedDateIso={selectedDateIso}
      positions={providerSky.positions}
      aspects={providerSky.aspects}
      moon={providerSky.moon}
      content={content}
      editAttributes={moonAspectEditAttributes}
    />
    </> : <EmptyState title={providerUnavailable.title} description={providerUnavailable.description} variant="panel" actionLabel={providerUnavailable.retry} actionHref={Astro.url.pathname + Astro.url.search} ariaLive="polite" />}
    </div>
    <TodaysSkyPersonalizedHandoff
      copy={personalizedHandoffCopy}
      locale={locale}
      editAttributes={personalizedHandoffEditAttributes}
    />
  </main>

  <Footer
    brandLabel={content.footer_brand_name}
    brandHref={localizePath("/", locale)}
    description={content.footer_about}
    groups={footerGroups}
    legalLinks={footerLegalLinks}
    copyrightText={content.footer_copyright}
    navigationLabel={content.footer_navigation_label}
    legalNavigationLabel={content.footer_legal_navigation_label}
    brandEditAttributes={componentEditAttributes(
      chromeEdit("footer_brand_name"),
    )}
    descriptionEditAttributes={componentEditAttributes(
      chromeEdit("footer_about"),
    )}
    copyrightEditAttributes={componentEditAttributes(
      chromeEdit("footer_copyright"),
    )}
  />
</BaseLayout>
