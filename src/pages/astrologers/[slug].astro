---
import type { BuilderEditAttributes } from "../../builder/builder.ts";
import { loadPublicPageContent } from "../../builder/public-page.ts";
import AstrologerProfile from "../../components/astrologers/sections/AstrologerProfile.astro";
import AstrologerLiveSession from "../../components/astrologers/sections/AstrologerLiveSession.astro";
import AstrologerSessionSetup from "../../components/astrologers/sections/AstrologerSessionSetup.astro";
import AstrologerSessionSummary from "../../components/astrologers/sections/AstrologerSessionSummary.astro";
import Footer from "../../components/shared/Footer.astro";
import Header from "../../components/shared/Header.astro";
import type { AstrologerProfilePickerCopy } from "../../data/locale/astrologers/sections/browse.ts";
import type { AstrologerProfileCopy } from "../../data/locale/astrologers/sections/profile.ts";
import type { AstrologerLiveSessionCopy } from "../../data/locale/astrologers/sections/live-session.ts";
import type { AstrologerSessionSetupCopy } from "../../data/locale/astrologers/sections/session-setup.ts";
import type { AstrologerSessionSummaryCopy } from "../../data/locale/astrologers/sections/session-summary.ts";
import type { PreparedBirthChartResult } from "../../data/birth-chart/results.ts";
import { getBirthChartResultsCopy } from "../../data/locale/birth-chart/sections/results.ts";
import { getSynastrySetupCopy } from "../../data/locale/synastry/sections/two-profile-setup.ts";
import {
  activeLocales,
  defaultLocale,
  localizePath,
  type SupportedLocale,
} from "../../data/localization-contract.ts";
import { createSharedFooterProps } from "../../data/shared-footer-navigation.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAstrologerBySlug } from "../../server/aggregator/astrologer-directory.ts";
import {
  getAstrologyChatSessionDetail,
  listAstrologyChatSessions,
} from "../../server/aggregator/astrology-chat.ts";
import { listBirthChartReadings } from "../../server/aggregator/birth-chart-api.ts";
import { getCustomerSession } from "../../server/aggregator/customer-auth.ts";
import { listCustomerUserProfiles } from "../../server/aggregator/customer-profiles.ts";
import { getCustomerWalletSummary, listWalletTransactions } from "../../server/aggregator/wallet-store.ts";
import { getRuntimeEnv } from "../../server/generated-site/request.ts";
import "../../styles/astrologers/astrologers.css";

export const prerender = false;

const {
  content,
  locale,
  builder,
  builderPage,
  chromePage,
  reviewTargets,
  builderEdit,
  chromeEdit,
} = await loadPublicPageContent(Astro, "astrologers");
const runtimeEnv = await getRuntimeEnv(Astro);
const astrologer = await getAstrologerBySlug(runtimeEnv, Astro.params.slug ?? "");
if (!astrologer) {
  return Astro.redirect(localizePath("/astrologers", locale));
}
const customerSession = await getCustomerSession(runtimeEnv, Astro.request).catch(
  () => null,
);
const requestedSessionId = Astro.url.searchParams.get("sessionId") ?? "";
const chatDetail = customerSession && requestedSessionId
  ? await getAstrologyChatSessionDetail(
      runtimeEnv,
      customerSession.account.id,
      requestedSessionId,
    )
  : null;
const chatSessions = customerSession && chatDetail
  ? (
      await listAstrologyChatSessions({
        env: runtimeEnv,
        accountId: customerSession.account.id,
        pageSize: 50,
      })
    ).sessions
  : [];
const customerProfiles = customerSession
  ? await listCustomerUserProfiles(runtimeEnv, customerSession.account.id)
  : [];
const customerWallet = customerSession
  ? await getCustomerWalletSummary(runtimeEnv, customerSession.account.id, locale)
  : null;
const walletTransactions = customerSession && chatDetail
  ? await listWalletTransactions(runtimeEnv, customerSession.account.id, {
      limit: 50,
      locale,
    })
  : [];
const requestedProfileId =
  chatDetail?.session.profileId ?? Astro.url.searchParams.get("profileId") ?? "";
const defaultProfileId =
  customerProfiles.find((profile) => profile.id === requestedProfileId)?.id ??
  customerProfiles[0]?.id ??
  "";
const profileFormCopy = getSynastrySetupCopy(locale);
const birthChartCopy = getBirthChartResultsCopy(locale);
type CustomerChartReading = {
  id: string;
  profileId: string;
  generatedAt: string;
  chart: PreparedBirthChartResult;
};
const customerChartReadings: CustomerChartReading[] = customerSession
  ? (
      await listBirthChartReadings({
        env: runtimeEnv,
        accountId: customerSession.account.id,
        pageSize: 50,
      }).catch(() => ({ items: [] }))
    ).items
  : [];
const selectedCustomerProfile = customerProfiles.find(
  (profile) => profile.id === defaultProfileId,
);
const selectedCustomerReading = selectedCustomerProfile
  ? customerChartReadings.find(
      (reading) =>
        reading.profileId === selectedCustomerProfile.id &&
        (selectedCustomerProfile.createdAt === selectedCustomerProfile.updatedAt ||
          Date.parse(reading.generatedAt) >=
            Date.parse(selectedCustomerProfile.updatedAt)),
    )
  : undefined;
const birthChartRoleLabels = {
  sun: birthChartCopy.results_sun_role,
  moon: birthChartCopy.results_moon_role,
  rising: birthChartCopy.results_rising_role,
};
const selectedCustomerSummary = selectedCustomerReading
  ? selectedCustomerReading.chart.bigThree
      .map(
        (placement) =>
          `${placement.sign} ${birthChartRoleLabels[placement.role]}`,
      )
      .join(" · ") ||
    [
      selectedCustomerReading.chart.birthSummary,
      selectedCustomerReading.chart.birthPlace,
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
const customerChart =
  selectedCustomerProfile && selectedCustomerReading && selectedCustomerSummary
    ? {
        profileName: selectedCustomerProfile.profileName,
        summary: selectedCustomerSummary,
        href: localizePath(
          `/birth-chart/${encodeURIComponent(selectedCustomerReading.id)}`,
          locale,
        ),
        rotation: selectedCustomerReading.chart.chartRotation || 0,
        planets: selectedCustomerReading.chart.planets.map((planet) => ({
          glyph: planet.glyph,
          longitude: planet.longitude,
          label: planet.name,
          color: planet.color,
        })),
        placements: (["sun", "moon", "rising"] as const).map((role) => {
          const bigThree = selectedCustomerReading.chart.bigThree.find(
            (placement) => placement.role === role,
          );
          const planet = selectedCustomerReading.chart.planets.find((item) => {
            const name = item.name.toLowerCase();
            return role === "rising"
              ? name.includes("ascendant") || name.includes("rising")
              : name === role;
          });
          const position = planet
            ? [planet.degreeText, planet.signName].filter(Boolean).join(" ")
            : bigThree?.sign || "";
          return {
            role,
            label: [birthChartRoleLabels[role], position]
              .filter(Boolean)
              .join(" · "),
          };
        }).filter((placement) => placement.label),
      }
    : undefined;

const seoContent = {
  seo_title: `${astrologer.name} · ${content.seo_title}`,
  seo_description: astrologer.description,
  seo_canonical_path: `/astrologers/${astrologer.slug}`,
  seo_robots: content.seo_robots,
  og_title: `${astrologer.name} · ${content.og_title}`,
  og_description: astrologer.description,
  og_image: astrologer.imageUrl,
  og_image_alt: astrologer.name,
  twitter_card: content.twitter_card,
  twitter_title: `${astrologer.name} · ${content.twitter_title}`,
  twitter_description: astrologer.description,
  twitter_image: astrologer.imageUrl,
};

const componentEditAttributes = (
  attributes: BuilderEditAttributes,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(attributes)
      .filter((entry): entry is [string, string | true] => entry[1] !== undefined)
      .map(([key, value]) => [key, value === true ? "true" : value]),
  );

const localeHref = (targetLocale: SupportedLocale) => {
  const url = new URL(Astro.request.url);
  if (targetLocale === defaultLocale) {
    if (locale === defaultLocale) url.searchParams.delete("locale");
    else url.searchParams.set("locale", defaultLocale);
  } else {
    url.searchParams.set("locale", targetLocale);
  }
  return `${url.pathname}${url.search}${url.hash}`;
};

const navigation = [
  ["nav_todays_sky", "/todays-sky"],
  ["nav_charts", "/birth-chart"],
  ["nav_compatibility", "/synastry"],
  ["nav_moon", "/moon-calendar"],
  ["nav_horoscope", "/daily-horoscope"],
  ["nav_astrologers", "/astrologers"],
  ["nav_blog", "/blog"],
].map(([field, path]) => ({
  label: content[field],
  href: localizePath(path, locale),
  current: path === "/astrologers",
  editAttributes: componentEditAttributes(chromeEdit(field)),
}));

const actions = [
  {
    id: "sign-in",
    label: content.action_sign_in,
    href: localizePath("/login", locale),
    variant: "ghost" as const,
    editAttributes: componentEditAttributes(chromeEdit("action_sign_in")),
  },
  {
    id: "get-chart",
    label: content.action_get_chart,
    href: localizePath("/birth-chart", locale),
    variant: "primary" as const,
    editAttributes: componentEditAttributes(chromeEdit("action_get_chart")),
  },
];

const languageOptions = activeLocales.map((item) => {
  const field = `language_option_${item.code}_label`;
  return {
    code: item.code,
    label: content[field] || item.nativeName,
    href: localeHref(item.code),
    lang: item.code,
    hreflang: item.hreflang,
    editAttributes: componentEditAttributes(chromeEdit(field)),
  };
});

const profileCopy: AstrologerProfileCopy = {
