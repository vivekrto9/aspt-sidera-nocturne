const sessionSummaryCopy: AstrologerSessionSummaryCopy = {
  liveOverline: content.summary_live_overline,
  liveTitle: content.summary_live_title,
  liveBody: content.summary_live_body,
  bookedOverline: content.summary_booked_overline,
  bookedTitle: content.summary_booked_title,
  bookedBody: content.summary_booked_body,
  sentOverline: content.summary_sent_overline,
  sentTitle: content.summary_sent_title,
  sentBody: content.summary_sent_body,
  sessionTypeLabel: content.summary_session_type_label,
  durationLabel: content.summary_duration_label,
  freeIntroLabel: content.summary_free_intro_label,
  freeIntroValue: content.summary_free_intro_value,
  billedAtLabel: content.summary_billed_at_label,
  whenLabel: content.summary_when_label,
  lengthLabel: content.summary_length_label,
  typeLabel: content.summary_type_label,
  replyByLabel: content.summary_reply_by_label,
  chartLabel: content.summary_chart_label,
  sharedValue: content.summary_shared_value,
  totalChargedLabel: content.summary_total_charged_label,
  estimatedTotalLabel: content.summary_estimated_total_label,
  ratingTitle: content.summary_rating_title,
  ratingAriaLabel: content.summary_rating_aria_label,
  notePlaceholder: content.summary_note_placeholder,
  livePrimaryAction: content.summary_live_primary_action,
  bookedPrimaryAction: content.summary_booked_primary_action,
  sentPrimaryAction: content.summary_sent_primary_action,
  backAction: content.summary_back_action,
  returnHome: content.summary_return_home,
};

const summaryParam = Astro.url.searchParams.get("summary");
const isSessionSummary = ["live", "booked", "sent"].includes(summaryParam ?? "");
const summaryMode = (isSessionSummary ? summaryParam : "live") as "live" | "booked" | "sent";
const sessionTypeKey = Astro.url.searchParams.get("sessionType") ?? "chat";
const sessionTypeLabels = {
  chat: sessionSetupCopy.liveChat,
  voice: sessionSetupCopy.voiceCall,
  video: sessionSetupCopy.videoCall,
  written: sessionSetupCopy.writtenQuestion,
} as const;
const sessionRates = {
  chat: astrologer.rate,
  voice: astrologer.rate + 0.6,
  video: astrologer.rate + 1.2,
  written: 19,
} as const;
const resolvedSessionType = sessionTypeKey in sessionTypeLabels
  ? (sessionTypeKey as keyof typeof sessionTypeLabels)
  : "chat";
const parsedDuration = Number.parseInt(Astro.url.searchParams.get("duration") ?? "222", 10);
const durationSeconds = Number.isFinite(parsedDuration) ? parsedDuration : 222;
const scheduledWhen = Astro.url.searchParams.get("slot") || sessionSetupCopy.slotOne;
const scheduledLength = Astro.url.searchParams.get("duration") || "30";

const isPaymentReturn = Astro.url.searchParams.get("payment") === "success";
const isLiveSession = !isSessionSummary && Boolean(chatDetail);
const isSessionSetup =
  !isLiveSession && (Astro.url.searchParams.get("book") === "1" || isPaymentReturn);

if (isSessionSetup && !customerSession && !builder.launcherEnabled) {
  return Astro.redirect(
    `${localizePath("/login", locale)}?next=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`,
    302,
  );
}

const footerProps = createSharedFooterProps({
  content,
  locale,
  editAttributes: (field) => componentEditAttributes(chromeEdit(field)),
});
---

<BaseLayout
  seo={seoContent}
  bodyClass="astrologers-body"
  builderToolbar={{
    launcherEnabled: builder.launcherEnabled,
    studioModeEnabled: builder.studioModeEnabled,
    collection: builder.collection,
    entry: builder.entry,
    locale: builder.locale,
    csrfToken: builder.csrfToken,
    canPublish: builder.canPublish,
    seo: seoContent,
    hasSavedDraft: builderPage.hasSavedDraft || chromePage.hasSavedDraft,
    reviewTargets,
  }}
>
  {
    !isLiveSession && (
      <Header
        id="astrologer-profile-header"
        brandLabel={content.brand_name}
        brandHref={localizePath("/", locale)}
        brandAriaLabel={content.brand_aria_label}
        navigationLabel={content.primary_navigation_label}
        chromeNavigation={{ content, edit: chromeEdit }}
        navigation={navigation}
        actions={actions}
        language={{
          activeLocale: locale,
          options: languageOptions,
          triggerLabel: content.language_trigger_label,
          menuLabel: content.language_menu_label,
        }}
        mobileUtilityActionId="sign-in"
        menuLabel={content.menu_open_label}
        closeMenuLabel={content.menu_close_label}
        brandEditAttributes={componentEditAttributes(chromeEdit("brand_name"))}
      />
    )
  }

  <main class="astrologers-page">
    {
      isSessionSummary ? (
        <AstrologerSessionSummary
          astrologer={astrologer}
          copy={sessionSummaryCopy}
          mode={summaryMode}
          sessionType={sessionTypeLabels[resolvedSessionType]}
          durationSeconds={durationSeconds}
          scheduledWhen={scheduledWhen}
          scheduledLength={scheduledLength}
          rate={sessionRates[resolvedSessionType]}
          locale={locale}
          bookingHref={localizePath(`/astrologers/${astrologer.slug}?book=1`, locale)}
          browseHref={localizePath("/astrologers", locale)}
          homeHref={localizePath("/", locale)}
          editAttributes={(field: string) => componentEditAttributes(builderEdit(field))}
        />
      ) : isLiveSession ? (
        <AstrologerLiveSession
          astrologer={astrologer}
          copy={liveSessionCopy}
          sessionMode={sessionSetupCopy.liveChat}
          sessionActive={chatDetail?.session.status === "active"}
          sessionId={chatDetail?.session.id || ""}
          csrfToken={customerSession?.csrfToken || ""}
          walletBalance={customerWallet?.balance || "$0"}
          walletBalanceCents={customerWallet?.balanceCents || 0}
          questionPrice={new Intl.NumberFormat(locale, {
            style: "currency",
            currency: "USD",
            minimumFractionDigits: 2,
          }).format((chatDetail?.session.priceCents || 0) / 100)}
          questionPriceCents={chatDetail?.session.priceCents || 0}
          walletHref={localizePath("/wallet", locale)}
          newChatHref={localizePath("/astrologers", locale)}
          locale={locale}
          chatSessions={chatSessions}
          walletTransactions={walletTransactions}
          activeProfileLabel={[
            chatDetail?.session.profileName,
            chatDetail?.session.partnerProfileName,
          ].filter(Boolean).join(" + ")}
          initialMessages={chatDetail?.messages || []}
          chartContext={{
            owner:
              customerChart?.profileName ||
              selectedCustomerProfile?.profileName ||
              chatDetail?.session.profileName ||
              "",
            label:
              customerChart?.summary ||
              [selectedCustomerProfile?.birthDate, selectedCustomerProfile?.birthPlace]
                .filter(Boolean)
                .join(" · "),
            rotation: customerChart?.rotation || 0,
            planets: customerChart?.planets || [],
            placements: customerChart?.placements || [],
          }}
          exitHref={localizePath(`/astrologers/${astrologer.slug}`, locale)}
          editAttributes={(field: string) => componentEditAttributes(builderEdit(field))}
        />
      ) : isSessionSetup ? (
        <AstrologerSessionSetup
          astrologer={astrologer}
          copy={sessionSetupCopy}
          locale={locale}
          profileHref={localizePath(`/astrologers/${astrologer.slug}`, locale)}
          chartHref={localizePath("/account#people", locale)}
          nextHref={localizePath(`/astrologers/${astrologer.slug}`, locale)}
          csrfToken={customerSession?.csrfToken || ""}
          astrologerSlug={astrologer.slug}
          profileId={defaultProfileId}
          loginHref={localizePath("/login", locale)}
          editAttributes={(field: string) => componentEditAttributes(builderEdit(field))}
        />
      ) : (
        <AstrologerProfile
          astrologer={astrologer}
          copy={profileCopy}
          pickerCopy={profilePickerCopy}
          profileFormCopy={profileFormCopy}
          customerProfiles={customerProfiles}
          customerChart={customerChart}
          authenticated={Boolean(customerSession)}
          csrfToken={customerSession?.csrfToken || ""}
          locale={locale}
          browseHref={localizePath("/astrologers", locale)}
          bookingHref={localizePath(`/astrologers/${astrologer.slug}?book=1`, locale)}
          chatHref={localizePath("/chat", locale)}
          loginHref={localizePath("/login", locale)}
          availabilityLabels={{
            online: content.online_now,
            busy: content.busy_label,
            offline: content.offline_label,
          }}
          editAttributes={(field) => componentEditAttributes(builderEdit(field))}
        />
      )
    }
  </main>

  {!isLiveSession && <Footer {...footerProps} />}
</BaseLayout>
