---
import type { BuilderEditAttributes } from "../builder/builder.ts";
import { loadPublicPageContent } from "../builder/public-page.ts";
import { getAuthResetPasswordFormCopy } from "../data/locale/auth/sections/reset-password-form.ts";
import AuthShell from "../components/shared/AuthShell.astro";
import AuthResetPasswordForm from "../components/auth/sections/AuthResetPasswordForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getResetPasswordShellCopy } from "../data/locale/auth/common/reset-password-shell.ts";

export const prerender = false;

const {
  content,
  locale,
  builder,
  builderPage,
  chromePage,
  reviewTargets,
  builderEdit,
} = await loadPublicPageContent(Astro, "reset-password");
const shellCopy = getResetPasswordShellCopy(locale);
const baseFormCopy = getAuthResetPasswordFormCopy(locale);
const formCopy = {
  ...baseFormCopy,
  heading: content.reset_password_form_heading,
  subheading: content.reset_password_form_subheading,
  passwordLabel: content.reset_password_password_label,
  passwordPlaceholder: content.reset_password_password_placeholder,
  confirmPasswordLabel: content.reset_password_confirm_label,
  confirmPasswordPlaceholder: content.reset_password_confirm_placeholder,
  passwordHint: content.reset_password_password_hint,
  submitLabel: content.reset_password_submit_label,
  loadingLabel: content.reset_password_loading_label,
  successLabel: content.reset_password_success_label,
  mismatchLabel: content.reset_password_mismatch_label,
  invalidPasswordLabel: content.reset_password_invalid_password_label,
  loginPrompt: content.reset_password_login_prompt,
  loginLabel: content.reset_password_login_label,
};

const componentEditAttributes = (
  attributes: BuilderEditAttributes,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(attributes)
      .filter(
        (entry): entry is [string, string | true] => entry[1] !== undefined,
      )
      .map(([key, value]) => [key, value === true ? "true" : value]),
  );

const panelPerks = [
  {
    icon: "✦",
    label: content.reset_password_proof_1_label,
    labelEditAttributes: componentEditAttributes(
      builderEdit("reset_password_proof_1_label"),
    ),
  },
  {
    icon: "✦",
    label: content.reset_password_proof_2_label,
    labelEditAttributes: componentEditAttributes(
      builderEdit("reset_password_proof_2_label"),
    ),
  },
];

const seoContent = {
  seo_title: content.seo_title,
  seo_description: content.seo_description,
  seo_canonical_path: content.seo_canonical_path,
  seo_robots: content.seo_robots,
  og_title: content.og_title,
  og_description: content.og_description,
  og_image: content.og_image,
  og_image_alt: content.og_image_alt,
  twitter_card: content.twitter_card,
  twitter_title: content.twitter_title,
  twitter_description: content.twitter_description,
  twitter_image: content.twitter_image,
};
---

<BaseLayout
  seo={seoContent}
  bodyClass="sidera-auth-body"
  builderToolbar={{
    launcherEnabled: builder.launcherEnabled,
    studioModeEnabled: builder.studioModeEnabled,
    collection: builder.collection,
    entry: builder.entry,
    locale: builder.locale,
    csrfToken: builder.csrfToken,
    canPublish: builder.canPublish,
    seo: seoContent,
    hasSavedDraft: builderPage.hasSavedDraft || chromePage.hasSavedDraft,
    reviewTargets,
  }}
>
  <AuthShell
    id="reset-password"
    brandLabel={content.reset_password_brand_label}
    brandHref="/"
    brandAriaLabel={content.reset_password_brand_aria_label}
    backLabel={content.reset_password_back_label}
    backHref="/"
    panelKicker={content.reset_password_panel_kicker}
    panelTitle={content.reset_password_panel_title}
    panelDescription={content.reset_password_panel_description}
    perks={panelPerks}
    formLabel={shellCopy.formLabel}
    locale={locale}
    brandEditAttributes={componentEditAttributes(
      builderEdit("reset_password_brand_label"),
    )}
    backEditAttributes={componentEditAttributes(
      builderEdit("reset_password_back_label"),
    )}
    kickerEditAttributes={componentEditAttributes(
      builderEdit("reset_password_panel_kicker"),
    )}
    titleEditAttributes={componentEditAttributes(
      builderEdit("reset_password_panel_title"),
    )}
    descriptionEditAttributes={componentEditAttributes(
      builderEdit("reset_password_panel_description"),
    )}
  >
    <AuthResetPasswordForm
      copy={formCopy}
      locale={locale}
      editAttributes={(field) =>
        componentEditAttributes(builderEdit(field))}
    />
  </AuthShell>
</BaseLayout>
