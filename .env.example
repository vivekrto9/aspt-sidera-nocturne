# Safe example only. Do not put real values in this file.

PUBLIC_SITE_NAME=Sidera

# Cloudflare account access for deployment workflows.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_DEV_WORKERS_SUBDOMAIN=replace-with-workers-dev-subdomain
CLOUDFLARE_SECRETS_STORE_ID=replace-with-optional-cloudflare-secret-store-id

# Worker runtime secrets. Keep real values in GitHub or Cloudflare, not in source.
EMDASH_ENCRYPTION_KEY=replace-with-emdash-encryption-key
BUILDER_MCP_TOKEN=ec_pat_replace-with-builder-mcp-token
BUILDER_MCP_PROVISION_SECRET=replace-with-builder-mcp-provision-secret

# AstroPages generated-site SSO and deployment callbacks.
ASTROPAGES_PROJECT_ID=replace-with-project-id
ASTROPAGES_SITE_ENVIRONMENT=preview
ASTROPAGES_SSO_PUBLIC_JWK=replace-with-control-plane-public-jwk
ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN=replace-with-control-plane-callback-token
ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL=https://astropages.example

# Generated-site Stripe Checkout. Real values belong in Cloudflare secrets.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret

# Astrology JSON endpoints and provider-backed chat.
ASTROLOGY_API_BASE_URL=replace-with-astrology-api-base-url
X_ASTROLOGYAPI_KEY=replace-with-astrologyapi-key
ASTROLOGYAPI_CHAT_BASE_URL=https://json-chat.astrologyapi.com

# Calendly availability, invitee creation, and signed lifecycle webhooks.
CALENDLY_API_TOKEN=replace-with-calendly-api-token
CALENDLY_WEBHOOK_SIGNING_KEY=replace-with-calendly-webhook-signing-key
CALENDLY_15_MIN_EVENT_TYPE_URI=https://api.calendly.com/event_types/replace-15
CALENDLY_30_MIN_EVENT_TYPE_URI=https://api.calendly.com/event_types/replace-30
CALENDLY_45_MIN_EVENT_TYPE_URI=https://api.calendly.com/event_types/replace-45
CALENDLY_60_MIN_EVENT_TYPE_URI=https://api.calendly.com/event_types/replace-60

# Optional GitHub repository variable repair token for generated resource ids.
GH_REPOSITORY_VARIABLES_TOKEN=replace-with-github-token

# Generated-site deployment variables managed by AstroPages or repair scripts.
PREVIEW_SITE_D1_DATABASE_ID=replace-with-preview-d1-id
PREVIEW_SITE_SESSION_KV_NAMESPACE_ID=replace-with-preview-kv-id
PREVIEW_SITE_URL=https://sidera-nocturne-preview.example.workers.dev
PRODUCTION_SITE_D1_DATABASE_ID=replace-with-production-d1-id
PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID=replace-with-production-kv-id
PRODUCTION_SITE_URL=https://sidera-nocturne-production.example.workers.dev
