{
  "templateKey": "sidera-nocturne",
  "displayName": "Sidera Nocturne",
  "stage": "starter-template",
  "catalogPreviewUrl": "https://sidera-nocturne-preview.alok-prasad.workers.dev",
  "repo": {
    "url": "https://github.com/vivekrto9/aspt-sidera-nocturne.git",
    "commitSha": "RESOLVED_AT_TEMPLATE_REGISTRATION"
  },
  "runtime": {
    "type": "official-emdash-astro-cloudflare",
    "scaffold": {
      "package": "create-emdash",
      "version": "0.14.0",
      "template": "cloudflare:starter"
    },
    "requiredFiles": [
      "astro.config.mjs",
      "src/live.config.ts",
      "src/worker.ts",
      "wrangler.jsonc"
    ],
    "adminPath": "/_emdash/admin",
    "apiPrefix": "/_emdash/api"
  },
  "analytics": {
    "required": true,
    "path": "astropages/analytics.manifest.json"
  },
  "leads": {
    "required": true,
    "path": "astropages/leads.manifest.json"
  },
  "cloudflare": {
    "runtimeContractStatus": "defined",
    "wranglerConfig": "wrangler.jsonc",
    "environments": [
      {
        "name": "preview",
        "workerName": "sidera-nocturne-preview",
        "d1DatabaseName": "sidera-nocturne-preview-site",
        "r2BucketName": "sidera-nocturne-preview-media",
        "kvNamespaceName": "sidera-nocturne-preview-session",
        "siteUrlVariable": "PREVIEW_SITE_URL",
        "d1DatabaseIdVariable": "PREVIEW_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID"
      },
      {
        "name": "production",
        "workerName": "sidera-nocturne-production",
        "d1DatabaseName": "sidera-nocturne-production-site",
        "r2BucketName": "sidera-nocturne-production-media",
        "kvNamespaceName": "sidera-nocturne-production-session",
        "siteUrlVariable": "PRODUCTION_SITE_URL",
        "d1DatabaseIdVariable": "PRODUCTION_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID"
      }
    ],
    "bindings": [
      {
        "name": "DB",
        "type": "d1",
        "purpose": "EmDash and generated-site runtime data"
      },
      {
        "name": "MEDIA",
        "type": "r2",
        "purpose": "EmDash media storage"
      },
      {
        "name": "SESSION",
        "type": "kv",
        "purpose": "Astro and EmDash session storage"
      },
      {
        "name": "LOADER",
        "type": "worker_loader",
        "purpose": "EmDash plugin sandboxing"
      },
      {
        "name": "IMAGES",
        "type": "images",
        "purpose": "Astro Cloudflare image transformation"
      }
    ]
  },
  "secrets": {
    "requiredNow": [
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForTemplateDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForGeneratedSiteDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL",
      "ASTROPAGES_SSO_PUBLIC_JWK"
    ],
    "deploymentVariables": [
      "GH_REPOSITORY_VARIABLES_TOKEN",
      "CLOUDFLARE_SECRETS_STORE_ID",
      "PREVIEW_SITE_D1_DATABASE_ID",
      "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID",
      "PREVIEW_SITE_URL",
      "PRODUCTION_SITE_D1_DATABASE_ID",
      "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID",
      "PRODUCTION_SITE_URL"
    ],
    "deploymentMapping": {
      "workerSecretsFile": "sidera-nocturne-worker-secrets.json",
      "workerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "BUILDER_MCP_TOKEN",
        "BUILDER_MCP_PROVISION_SECRET"
      ],
      "generatedSiteWorkerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN"
      ],
      "generatedSiteRuntimeVars": [
        "ASTROPAGES_PROJECT_ID",
        "ASTROPAGES_SITE_ENVIRONMENT",
        "ASTROPAGES_SSO_PUBLIC_JWK"
      ],
      "platformGooglePlacesBinding": "ASTROPAGES_PLATFORM_GOOGLE_PLACES_GOOGLE_PLACES_API_KEY"
    },
    "valuesAllowedInSource": false,
    "generatedSiteRuntimeConfig": [
      "SES_SENDER_EMAIL",
      "SES_SENDER_NAME",
      "AWS_REGION",
      "ASTROLOGY_API_BASE_URL",
      "ASTROLOGYAPI_CHAT_BASE_URL",
      "CALENDLY_15_MIN_EVENT_TYPE_URI",
      "CALENDLY_30_MIN_EVENT_TYPE_URI",
      "CALENDLY_45_MIN_EVENT_TYPE_URI",
      "CALENDLY_60_MIN_EVENT_TYPE_URI"
    ],
    "providerCredentials": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "X_ASTROLOGYAPI_KEY",
      "CALENDLY_API_TOKEN",
      "CALENDLY_WEBHOOK_SIGNING_KEY"
    ]
  },
  "localization": {
    "strategy": "query-param",
    "requiredDefaultLocale": "en",
    "defaultLocale": "en",
    "activeLocales": ["en", "es", "fr", "pt", "ru", "it", "de"],
    "availableLocaleCatalog": ["en", "es", "fr", "pt", "ru", "it", "de"],
    "maxActiveLocales": 8,
    "rtlSupported": false,
    "editableContentSource": "src/data/public-copy.ts",
    "publicEditableCollection": "multiple",
    "publicEditableEntries": [
      "site_account/account",
      "site_about/about",
      "site_blog_article_bodies/bodies",
      "site_blog_articles/articles",
      "site_blog/blog",
      "site_chrome/main",
      "site_astrologers/astrologers",
      "site_daily_horoscope/daily_horoscope",
      "site_daily_horoscope_cta/cta",
      "site_faq/faq",
      "site_glossary/glossary",
      "site_login/login",
      "site_signup/signup",
      "site_forgot_password/forgot-password",
      "site_reset_password/reset-password",
      "site_moon_calendar/moon_calendar",
      "site_reports/reports",
      "site_retrogrades/retrogrades",
      "site_shop/shop",
      "site_shop_catalog/catalog",
      "site_shop_checkout_flow/checkout-flow",
      "site_shop_product_detail/detail",
      "site_shop_product_descriptions/descriptions",
      "site_transit/transit",
      "site_transit_results/results",
      "site_pages/home",
      "site_pages/not_found_page"
    ],
    "disabledLocalePolicy": "new locales remain inactive until AstroPages enables and verifies translated copy"
  },
  "workflows": {
    "template": {
      "provider": "woodpecker",
      "configurationSource": "signed-control-plane-extension",
      "entrypoint": "pnpm run astropages:pipeline",
      "purposes": {
        "ci": "template_ci",
        "preview": "template_preview",
        "production": "template_production"
      },
      "githubSafetyCi": ".github/workflows/ci.yml",
      "catalogScreenshots": "admin-managed"
    },
    "generatedSite": {
      "previewSeed": ".astropages/generated-site-workflows/deploy-preview.yml",
      "previewInstalledPath": ".github/workflows/deploy-preview.yml",
      "previewTrigger": "control-plane-workflow-dispatch",
      "previewCallback": {
        "statusRoute": "/callback/preview-deployments/:previewDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      },
      "productionSeed": ".astropages/generated-site-workflows/deploy-production.yml",
      "productionInstalledPath": ".github/workflows/deploy-production.yml",
      "productionTrigger": "control-plane-workflow-dispatch",
      "productionCallback": {
        "statusRoute": "/callback/production-deployments/:productionDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      }
    }
  },
